+        assert len(ast.literal_eval(row["precision_tolerances"])) == 2
+    assert (
+        spec.FlashAttnSpec.golden(**arguments(), reference_mode="fp32")[0].dtype
+        == torch.float32
+    )
+    default = spec.FlashAttnSpec.golden(**arguments())
+    explicit = spec.FlashAttnSpec.golden(**arguments(), reference_mode="fp32")
+    assert default[0].dtype == torch.float32
+    for actual, expected in zip(default, explicit):
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    assert (
+        spec.FlashAttnSpec.golden(**arguments(), reference_mode="mixed")[0].dtype
+        == torch.float16
+    )
+    with pytest.raises(ValueError, match="reference_mode"):
+        spec.FlashAttnSpec.golden(**arguments(), reference_mode="invalid")
+
+
+def case_arguments(row, offset=0):
+    """CPU unit-test fixture only; runtime input generation belongs to TTK."""
+    names = tuple(inspect.signature(spec._load("inputs").customize_inputs).parameters)[
+        :11
+    ]
+    fields = {
+        key: ast.literal_eval(value)
+        for key, value in row.items()
+        if key
+        in (
+            "tensor_view_shapes",
+            "tensor_dtypes",
+            "attributes",
+            "input_data_ranges",
+            "tensor_storage_shapes",
+            "tensor_view_strides",
+            "tensor_view_offsets",
+        )
+        and value
+    }
+    generator = torch.Generator().manual_seed(41)
+    inputs = {}
+    for index, (name, shape, dtype) in enumerate(
+        zip(names, fields["tensor_view_shapes"], fields["tensor_dtypes"])
+    ):
+        if shape is None or shape == (-1,):
+            inputs[name] = None
+            continue
+        storage_shape = (
+            fields.get("tensor_storage_shapes", (None,) * 11)[index] or shape
+        )
+        strides = fields.get("tensor_view_strides", (None,) * 11)[index]
+        start = fields.get("tensor_view_offsets", (0,) * 11)[index] or 0
+        if offset and name in ("k", "v"):
+            storage_shape = (storage_shape[0] + 1, *storage_shape[1:])
+            start += offset
+        value = torch.zeros(storage_shape, dtype=getattr(torch, dtype))
+        if strides is not None:
+            value = value.as_strided(shape, strides, start)
+        if value.is_floating_point():
+            low, high = fields["input_data_ranges"][index]
+            value.copy_(torch.empty(shape).uniform_(low, high, generator=generator))
+        inputs[name] = value
+    attrs = fields["attributes"]
+    spec.FlashAttnSpec.customize_inputs(**inputs, **attrs)
+    return dict(attrs, **inputs)
+
