+                    raise ValueError("unsupported inner KV cache stride")
+                inner *= tensor.shape[dim]
+    mode, left, right = (
+        arguments[name] for name in ("mask_mode", "win_left", "win_right")
+    )
+    if (
+        any(type(x) is not int for x in (mode, left, right))
+        or mode not in (0, 3, 4)
+        or min(left, right) < -1
+    ):
+        raise ValueError("mask_mode must be 0/3/4 and windows integers >= -1")
+    if mode in (0, 3) and (left, right) != (-1, -1):
+        raise ValueError("no-mask/causal mode requires win_left=win_right=-1")
+    mask = arguments["attn_mask"]
+    if mode == 0 and mask is not None:
+        raise ValueError("no-mask mode requires attn_mask=None")
+    if mode in (3, 4) and mask is None:
+        raise ValueError("causal/window mode requires the compressed attention mask")
+    if mask is not None and (mask.dtype != torch.int8 or mask.shape != (2048, 2048)):
+        raise ValueError("attn_mask must be int8 with shape (2048, 2048)")
+    sinks = arguments["sinks"]
+    if sinks is not None and (
+        sinks.dtype != torch.float32 or sinks.shape not in ((nq,), (0,))
+    ):
+        raise ValueError("sinks must be float32 with shape (num_heads_q,) or (0,)")
+    if type(arguments["return_softmax_lse"]) is not bool:
+        raise ValueError("return_softmax_lse must be bool")
+    if lq == "TND":
+        q_capacity = _sequence_lengths(
+            arguments["cu_seqlens_q"], q.shape[0], "cu_seqlens_q"
+        )
+    else:
+        if arguments["cu_seqlens_q"] is not None:
+            raise ValueError("cu_seqlens_q requires TND")
+        q_capacity = [q.shape[2 if lq == "BNSD" else 1]] * q.shape[0]
+    batch = len(q_capacity)
+    if not 0 < batch < 65536:
+        raise ValueError("batch must be in (0, 65536)")
+    table = arguments["block_table"]
+    if paged:
+        if (
+            table is None
+            or table.dtype != torch.int32
+            or table.ndim != 2
+            or table.shape[0] != batch
+        ):
+            raise ValueError(
+                "paged KV requires int32 block_table with one row per batch"
+            )
+        if block_size % 16 or block_size <= 0:
+            raise ValueError("paged KV block_size must be a positive multiple of 16")
+        if arguments["seqused_kv"] is None:
+            raise ValueError("paged KV requires seqused_kv")
+        kv_capacity = [table.shape[1] * block_size] * batch
+    elif lk == "TND":
+        kv_capacity = _sequence_lengths(
+            arguments["cu_seqlens_kv"], k.shape[0], "cu_seqlens_kv"
+        )
+    else:
+        if k.shape[0] != batch:
+            raise ValueError("Q and KV batch sizes must match")
+        kv_capacity = [block_size] * batch
+    if not paged and table is not None:
+        raise ValueError("block_table requires a paged KV layout")
+    if lk != "TND" and arguments["cu_seqlens_kv"] is not None:
+        raise ValueError("cu_seqlens_kv requires TND KV")
+    if len(kv_capacity) != batch:
+        raise ValueError("Q and KV must have the same batch count")
+    lengths = []
+    for name, layout, capacity in (("q", lq, q_capacity), ("kv", lk, kv_capacity)):
+        used = arguments[f"seqused_{name}"]
+        effective = (
+            _int_vector(used, f"seqused_{name}", batch)
+            if used is not None
+            else capacity
+        )
+        if any(x < 0 or x > cap for x, cap in zip(effective, capacity)):
+            raise ValueError(f"seqused_{name} exceeds physical capacity")
+        maximum = arguments[f"max_seqlen_{name}"]
+        if (
+            type(maximum) is not int
+            or maximum < -1
+            or (maximum >= 0 and maximum < max(effective))
+        ):
+            raise ValueError(
+                f"max_seqlen_{name} must cover every effective sequence or be -1"
+            )
+        if layout in ("BSND", "BNSD") and used is None and maximum == -1:
+            raise ValueError(f"{layout} requires seqused_{name} or max_seqlen_{name}")
+        lengths.append(effective)
+    if paged:
+        for b, length in enumerate(lengths[1]):
+            ids = table[b, : (length + block_size - 1) // block_size]
+            if ((ids < 0) | (ids >= k.shape[0])).any().item():
+                raise ValueError("block_table references a page outside the KV cache")
+    return tuple(lengths)
