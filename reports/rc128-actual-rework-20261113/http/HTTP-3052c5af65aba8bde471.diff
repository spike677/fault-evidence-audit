+
+def arguments(dtype=torch.float16, mode=4, lengths=((129, 5), (193, 3))):
+    cu_q, cu_k = [0], [0]
+    for sq, sk in zip(*lengths):
+        cu_q.append(cu_q[-1] + sq)
+        cu_k.append(cu_k[-1] + sk)
+    torch.manual_seed(17)
+    return dict(
+        q=torch.randn(cu_q[-1], 4, 256, dtype=dtype),
+        k=torch.randn(cu_k[-1], 2, 256, dtype=dtype),
+        v=torch.randn(cu_k[-1], 2, 256, dtype=dtype),
+        cu_seqlens_q=torch.tensor(cu_q, dtype=torch.int32),
+        cu_seqlens_kv=torch.tensor(cu_k, dtype=torch.int32),
+        max_seqlen_q=max(lengths[0]),
+        max_seqlen_kv=max(lengths[1]),
+        sinks=torch.tensor([-4.0, 0.0, 4.0, 10.0]),
+        mask_mode=mode,
+        win_left=127 if mode == 4 else -1,
+        win_right=0 if mode == 4 else -1,
+        attn_mask=torch.ones(2048, 2048, dtype=torch.int8).triu(1),
+        softmax_scale=0.0625,
+        layout_q="TND",
+        layout_kv="TND",
+        layout_out="TND",
+        block_table=None,
+        seqused_q=None,
+        seqused_kv=None,
+        metadata=None,
+        return_softmax_lse=True,
+    )
+
+
+def dense_reference(a, with_sink=True):
+    """Independent FP64 dense softmax, including sink as an extra zero-value key."""
+    outputs, lses = [], []
+    for b in range(a["cu_seqlens_q"].numel() - 1):
+        qs, qe = a["cu_seqlens_q"][b : b + 2].tolist()
+        ks, ke = a["cu_seqlens_kv"][b : b + 2].tolist()
+        q = a["q"][qs:qe].double().transpose(0, 1)
+        k = a["k"][ks:ke].double().repeat_interleave(2, dim=1).transpose(0, 1)
+        v = a["v"][ks:ke].double().repeat_interleave(2, dim=1).transpose(0, 1)
+        scores = (q @ k.transpose(-2, -1)) * a["softmax_scale"]
+        center = torch.arange(qe - qs)[:, None] + (ke - ks) - (qe - qs)
+        columns = torch.arange(ke - ks)[None, :]
+        mask = columns > center
+        if a["mask_mode"] == 4:
+            mask |= columns < center - a["win_left"]
+        scores.masked_fill_(mask[None, :, :], -torch.inf)
+        if with_sink and a["sinks"] is not None:
+            scores = torch.cat(
+                (scores, a["sinks"].double()[:, None, None].expand(-1, qe - qs, 1)),
+                dim=-1,
+            )
+            v = torch.cat((v, torch.zeros(4, 1, 256, dtype=torch.float64)), dim=1)
+        lse = scores.logsumexp(-1)
+        weights = torch.exp(scores - lse[..., None])
+        empty = torch.isneginf(lse)
+        weights = weights.masked_fill(empty[..., None], 0)
+        outputs.append((weights @ v).transpose(0, 1))
+        lses.append(lse.masked_fill(empty, torch.inf))
+    return torch.cat(outputs), torch.cat(lses, dim=1)
+
+
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16])
+@pytest.mark.parametrize("mode", [3, 4])
+def test_fa3_mapping_sink_and_fp32(monkeypatch, dtype, mode):
+    a = arguments(dtype, mode)
+    lengths = cross._validate_fa3(a)
+    calls = []
+
+    def fake_fa3(q, k, v, **kwargs):
+        calls.append(kwargs)
+        assert q is a["q"] and k is a["k"] and v is a["v"]
+        out, lse = dense_reference(a, with_sink=False)
+        return out.to(dtype), lse.float()
+
+    monkeypatch.setitem(
+        sys.modules,
+        "flash_attn_interface",
+        SimpleNamespace(flash_attn_varlen_func=fake_fa3),
+    )
+    actual = cross._fa3_attention(a, *lengths)
+    expected = dense_reference(a)
+    torch.testing.assert_close(actual[0].double(), expected[0], rtol=0.01, atol=0.003)
+    torch.testing.assert_close(actual[1].double(), expected[1], rtol=2e-6, atol=2e-6)
+    assert actual[0].dtype == dtype and actual[1].dtype == torch.float32
+    assert calls[0]["window_size"] == ((127, 0) if mode == 4 else (-1, -1))
+    assert calls[0]["causal"] == (mode == 3)
+    assert calls[0]["cu_seqlens_k"] is a["cu_seqlens_kv"]
+    assert calls[0]["return_attn_probs"] is True
+    reference = golden._run_reference(fp32.FP32Reference, a)
+    assert reference[0].dtype == torch.float32
+    for value, truth in zip(reference, expected):
+        torch.testing.assert_close(value.double(), truth, rtol=1e-5, atol=2e-6)
+    # The second sequence starts with two fully masked rows: sink-only LSE.
+    torch.testing.assert_close(actual[1][:, 129:131], a["sinks"][:, None].expand(-1, 2))
+    assert actual[0][129:131].count_nonzero() == 0
+
+
+def test_window_includes_exactly_128_keys(monkeypatch):
+    a = arguments(lengths=((257,), (257,)))
+    a["q"].zero_()
+    a["k"].zero_()
+    a["v"].fill_(1)
+    a["sinks"].zero_()
+
+    def fake_fa3(*args, **kwargs):
+        out, lse = dense_reference(a, with_sink=False)
+        return out.half(), lse.float()
+
+    monkeypatch.setitem(
+        sys.modules,
+        "flash_attn_interface",
+        SimpleNamespace(flash_attn_varlen_func=fake_fa3),
+    )
+    out, lse = cross._fa3_attention(a, *cross._validate_fa3(a))
+    counts = torch.arange(1, 258).clamp_max(128)
+    torch.testing.assert_close(lse[0], (counts + 1).float().log())
+    torch.testing.assert_close(out[:, 0, 0], (counts / (counts + 1)).half())
+
+
+@pytest.mark.parametrize(
