+import numpy as np
+import pytest
+import torch
+
+ASSETS = Path(__file__).with_name("assets")
+_spec = importlib.util.spec_from_file_location(
+    "flash_attn_fa3_test_spec", ASSETS / "spec.py"
+)
+spec = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(spec)
+cross = spec._load("fa3")
+policy = spec._load("cross_check")
+golden = spec._load("golden")
+fp32 = spec._load("fp32_reference")
