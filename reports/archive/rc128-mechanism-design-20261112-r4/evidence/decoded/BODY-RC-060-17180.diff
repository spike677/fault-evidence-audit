+    def _scatter(self, num_tokens=3, slots=None, dtype=torch.uint8):
+        key = (
+            torch.arange(num_tokens * self.NUM_KV_HEADS * self.HEAD_DIM, dtype=torch.int32)
+            .remainder(251)
+            .to(torch.uint8)
+            .reshape(num_tokens, self.NUM_KV_HEADS, self.HEAD_DIM)
