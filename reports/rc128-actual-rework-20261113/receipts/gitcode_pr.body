e href="#gt-more-operate" data-v-6e3ab9e5></use></svg><!--v-if--><!--]--><!--]--><!--]--><!--[--><!----><!--]--><!--]--></button><!--[--><!----><!--v-if--><!--]--><!--]--><!--]--><!--]--></div></div><div class="flex md:hidden items-center" data-v-6db6da52><!----><div class="g-fold-ellipsis event-msg-wrap" data-v-6db6da52 data-v-e614ac68><span style="width:auto;" class="g-fold-ellipsis-text" data-v-e614ac68><!--[--><!--[--><!--[--><span data-state="closed" data-grace-area-trigger>Apr 7</span><!--v-if--><!--]--><!--]--> Comments：<!--]--></span><!----></div></div></div><div data-v-6db6da52><div class="g-discussion-divide-line" data-v-6db6da52></div><div class="outside" data-v-6db6da52><div class="p-[16px] g-discussion-body" data-v-6db6da52><div id="render_167477503" class="md-render-wrapper" data-v-6db6da52 data-v-6443e0cc><div class="md-render" data-v-6443e0cc><h2 id="问题功能描述" tabindex="-1"><a href="#问题功能描述" name="问题功能描述" rel="nofollow" class="header-anchor"><span class="gitcode-anchor" style="display:inline-block;"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M11.182 1.98956C10.9867 1.7943 10.6702 1.7943 10.4749 1.98956L6.9393 5.52512L6.2322 4.81801L9.7678 1.28245C10.3536 0.696664 11.3033 0.696667 11.8891 1.28245L14.7175 4.11088C15.3033 4.69667 15.3033 5.64642 14.7175 6.2322L11.1819 9.76776L10.4748 9.06065L14.0104 5.52509C14.2057 5.32983 14.2057 5.01325 14.0104 4.81798L11.182 1.98956ZM1.98962 11.182C1.79436 10.9867 1.79436 10.6701 1.98962 10.4748L5.52516 6.93931L4.81805 6.23221L1.28252 9.76774C0.69673 10.3535 0.696729 11.3033 1.28252 11.8891L4.11094 14.7175C4.69673 15.3033 5.64648 15.3033 6.23226 14.7175L9.7678 11.182L9.06069 10.4748L5.52516 14.0104C5.32989 14.2056 5.01331 14.2056 4.81805 14.0104L1.98962 11.182ZM9.76775 5.52513L5.52511 9.76777L6.23221 10.4749L10.4749 6.23224L9.76775 5.52513Z" fill="var(--theme-icon-fill-weak)"></path></svg></span></a>问题/功能描述</h2>
<p>本次PR修改旨在解决因硬件控制寄存器状态未初始化，可能导致向量计算单元工作异常或性能下降的问题。通过在<code>ElementwiseSchWithScalar</code>类的构造函数中增加对特定硬件控制位的初始化操作，确保后续的向量化元素级计算能在正确的硬件环境下执行。</p>
<h2 id="修改方案描述" tabindex="-1"><a href="#修改方案描述" name="修改方案描述" rel="nofollow" class="header-anchor"><span class="gitcode-anchor" style="display:inline-block;"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M11.182 1.98956C10.9867 1.7943 10.6702 1.7943 10.4749 1.98956L6.9393 5.52512L6.2322 4.81801L9.7678 1.28245C10.3536 0.696664 11.3033 0.696667 11.8891 1.28245L14.7175 4.11088C15.3033 4.69667 15.3033 5.64642 14.7175 6.2322L11.1819 9.76776L10.4748 9.06065L14.0104 5.52509C14.2057 5.32983 14.2057 5.01325 14.0104 4.81798L11.182 1.98956ZM1.98962 11.182C1.79436 10.9867 1.79436 10.6701 1.98962 10.4748L5.52516 6.93931L4.81805 6.23221L1.28252 9.76774C0.69673 10.3535 0.696729 11.3033 1.28252 11.8891L4.11094 14.7175C4.69673 15.3033 5.64648 15.3033 6.23226 14.7175L9.7678 11.182L9.06069 10.4748L5.52516 14.0104C5.32989 14.2056 5.01331 14.2056 4.81805 14.0104L1.98962 11.182ZM9.76775 5.52513L5.52511 9.76777L6.23221 10.4749L10.4749 6.23224L9.76775 5.52513Z" fill="var(--theme-icon-fill-weak)"></path></svg></span></a>修改方案描述</h2>
<p>修改了<code>ElementwiseSchWithScalar</code>模板类的构造函数，在初始化成员变量前新增了三行代码。具体操作为：读取当前控制寄存器值，保留特定比特位（0x1000000000000），然后与新的控制位（0x1000000000000008）进行按位或操作，最后将结果写回寄存器。此修改通过原子操作（<code>get_ctrl</code>/<code>set_ctrl</code>）安全地配置了硬件功能，为后续计算提供了必要的硬件支持。</p>
