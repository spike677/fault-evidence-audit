29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":165867625,"discussion_id":"46c42c445c355e2dbb3f297f92667104205146c7","body":":large_blue_circle: source code change are detected, tasks labels is removed in this pull request!","created_at":"2026-03-20T12:20:43+08:00","updated_at":"2026-03-20T12:20:43+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":165867667,"discussion_id":"9616c15cad6d4e94bf7b5c1124a657921c748669","body":"## 问题/功能描述\n\n本次PR包含两个主要变更。一是修正了ScatterNd算子的产品支持列表和接口调用说明文档，将Ascend 950PR/Ascend 950DT产品的支持状态从不支持更正为支持，并修正了接口调用示例中的算子名称，确保文档准确性。二是修复了ScatterNd确定性算子内核在非量化分支下，多核并行处理相同索引时，因缺乏同步机制导致原子加操作顺序不确定，从而影响结果确定性的问题。\n\n## 修改方案描述\n\n修改方案分为两部分。针对文档问题，更新了产品支持列表中的支持状态，并将调用示例中引用的算子名称从“ScatterAdd”修正为“ScatterNdUpdate”。针对内核确定性问题，修正了非量化分支中输出张量的全局缓冲区地址设置，并在执行原子加操作后显式插入`PipeBarrier<PIPE_MTE3>`内存屏障，以确保多核并发对同一索引的写操作顺序执行，从而保证结果的确定性。","created_at":"2026-03-20T12:21:14+08:00","updated_at":"2026-03-20T12:21:14+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":166172871,"discussion_id":"eb4b3d9fd49077c31b496d8bbbcdb9a06dcd348f","body":":large_blue_circle: source code change are detected, tasks labels is removed in this pull request!","created_at":"2026-03-24T10:24:25+08:00","updated_at":"2026-03-24T10:24:25+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id"