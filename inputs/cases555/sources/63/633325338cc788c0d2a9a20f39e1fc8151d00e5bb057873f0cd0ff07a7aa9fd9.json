[{"id":8351609,"html_url":"https://gitcode.com/cann/ops-nn/merge_requests/1989","diff_url":"https://gitcode.com/cann/ops-nn/merge_requests/1989/diffs","number":1989,"state":"merged","title":"mn=1走vector实现","body":"## 描述\n<!--在这里详细描述你的改动，包括改动的原因和所采取的方法。-->\n本次PR旨在优化矩阵乘法（MatMul）算子在特定场景下的精度模式处理逻辑。核心功能是当输入矩阵的第一个维度（M）为1时，自动禁用高精度浮点模式（HF32），并采用Vector进行计算以确保计算正确性或提升性能。\n\n## 关联的Issue\n<!-- 如果这个PR是为了解决特定的Issue，请在这里提供Issue链接。例如：关联Issue #000-->\n关联Issue [#1365](https://gitcode.com/cann/ops-nn/issues/1365) \n\n## 测试\n<!--描述进行了哪些测试来验证你的改动。-->\n对m=1或n=1的case进行新精度标准的验证\n## 文档更新\n<!--如果这个PR包含文档的更新，请在这里指出。例如：更新了README.md文件。-->\n\n## 类型标签\n<!--  [x] 表示选中 -->\n- [x] Bug修复\n- [ ] 新特性\n- [ ] 性能优化\n- [ ] 文档更新\n- [ ] 其他，请描述：\n\n\n","created_at":"2026-02-24T10:32:08.324+08:00","updated_at":"2026-03-13T16:46:37.957+08:00","merged_at":"2026-03-13T16:46:36.017+08:00","head":{"ref":"mnEqual1","sha":"6b52bfbb4d5367a9c67bdf525d9f7bd5f67fdb4e","repo":{"path":"ops-nn","name":"ops-nn","full_name":"wuyufei/ops-nn"},"assigner":{"login":"wuyufei","name":"wuyufei"}},"base":{"ref":"master","sha":"f724a5505ca2d87b128639cbf067ecec398fb805","repo":{"path":"ops-nn","name":"ops-nn","full_name":"cann/ops-nn"}},"assignees":[],"testers":[],"labels":[{"id":3881,"color":"#555353","name":"stat/needs-squash","created_at":"2025-06-10T14:17:24+08:00","updated_at":"2026-02-24T10:51:12+08:00"},{"id":4929,"color":"#2865E0","name":"cann-cla/yes","created_at":"2025-06-21T10:53:09+08:00","updated_at":"2026-02-27T20:31:23+08:00"},{"id":2741,"color":"#17f207","name":"lgtm","created_at":"2025-05-29T20:14:01+08:00","updated_at":"2026-03-13T16:46:23+08:00"},{"id":2742,"color":"#22ed07","name":"approved","created_at":"2025-05-29T20:14:31+08:00","updated_at":"2026-03-13T11:48:33+08:00"},{"id":22553,"color":"#3ee029","name":"api-check-pass","created_at":"2025-12-16T09:45:21+08:00","updated_at":"2026-03-12T15:44:33+08:00"},{"id":3873,"color":"#21BA45","name":"ci-pipeline-passed","created_at":"2025-06-10T14:17:23+08:00","updated_at"