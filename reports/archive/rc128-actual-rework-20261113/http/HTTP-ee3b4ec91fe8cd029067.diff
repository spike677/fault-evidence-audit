+
+// r=0 with N*C=2000000 (fp32): per-core load 31250 exceeds the halved perLoopMax
+// (UB_SIZE/OUTPUT_NUM/elemSize = 245760/2/4 = 30720); perCorePerLoopElements must be capped
+// at 30720 so the kernel's mean/variance double-buffer (2*30720*4 = 240KB) fits in UB.
+// Locks the OUTPUT_NUM=2 UB reservation of the reduce-empty tiling.
+TEST_F(InstanceNormTilingTest, instance_norm_reduce_empty_fp32_large_nc_perloop_capped)
+{
+    optiling::InstanceNormReduceEmptyTilingDataForTest td;
+    uint64_t tilingKey = 0;
+    RunInstanceNormReduceEmptyTilingForTest(1, 2000000, ge::DT_FLOAT, &td, &tilingKey);
+    ASSERT_EQ(tilingKey, 50000);
+    EXPECT_EQ(td.perCoreElements, 31250);
+    EXPECT_EQ(td.lastCoreElements, 31250);
+    EXPECT_EQ(td.perCoreLoops, 2);
+    EXPECT_EQ(td.perCorePerLoopElements, 30720);
+    EXPECT_EQ(td.perCoreLastLoopElements, 530);
+    EXPECT_EQ(td.lastCoreLoops, 2);
+    EXPECT_EQ(td.lastCorePerLoopElements, 30720);
+    EXPECT_EQ(td.lastCoreLastLoopElements, 530);
+}
