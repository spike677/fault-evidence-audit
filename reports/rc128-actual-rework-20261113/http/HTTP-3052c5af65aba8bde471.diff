+
+"""CPU FP64 truth and NPU small-op benchmark for FlashAttn cross_check.
+
+As in mixed_quant_flash_attn, the benchmark executes QK/PV on NPU with
+original-precision operands and FP32 outputs; online softmax runs on CPU.
+Neither reference invokes the FlashAttn operator under test.
+"""
+
+import torch
+
+from .golden import FlashAttnGolden
+
+
+class FP64Reference(FlashAttnGolden):
+    COMPUTE_DTYPE = torch.float64
+
+    def forward_golden(self, q, k, v, **kwargs):
+        # Promote before extraction, softmax and output allocation. In particular,
+        # P must never round back to the original input dtype in the truth path.
+        return super().forward_golden(q.double(), k.double(), v.double(), **kwargs)
+
+
+class NpuSmallOpReference(FlashAttnGolden):
+    def _matmul(self, left, right):
+        import torch_npu  # noqa: F401
+
+        left = left.to(dtype=self._p_dtype, device="npu").contiguous()
+        right = right.to(dtype=self._p_dtype, device="npu").contiguous()
+        # Request the accumulation result explicitly: a normal low-dtype matmul
+        # would narrow its output before the FP32 online softmax/rescaling.
+        return torch.mm(left, right, out_dtype=torch.float32).cpu()
