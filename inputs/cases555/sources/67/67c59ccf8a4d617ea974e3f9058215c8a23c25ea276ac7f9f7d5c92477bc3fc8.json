6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":162889177,"discussion_id":"f2398dba689d16cba638bb94d6069a384efc8395","body":"compile","created_at":"2026-02-11T11:45:01+08:00","updated_at":"2026-02-11T11:45:01+08:00","user":{"id":"6822c64059bdd61f837dbc2e","login":"caihualilili","object_id":"6822c64059bdd61f837dbc2e","name":"liangfuzhan","html_url":"https://gitcode.com/caihualilili"},"comment_type":"pr_comment"},{"id":162889182,"discussion_id":"5b48652ade62623cc59744619f1c086636719df4","body":"### CLA Signature Pass  \n caihualilili, thanks for your pull request. All authors of the commits have signed the CLA. :+1: ","created_at":"2026-02-11T11:45:02+08:00","updated_at":"2026-02-11T11:45:02+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":162889279,"discussion_id":"3626abde58d962b3e20bd36357bd4cd89f104217","body":"## 问题/功能描述\n\n优化Fused Floyd Attention算子在特定高性能模式下的工作空间内存占用计算逻辑。原计算逻辑在估算stage2所需工作空间大小时，未考虑`n2`维度的分块大小，导致在NZND格式、FP32数据类型等场景下，工作空间大小估算不准确，可能引发内存分配与实际需求不匹配的问题。\n\n## 修改方案描述\n\n修改了`FusedFloydAttentionTilingS1s2Bn2gs1`类的`GetWorkspaceSize`函数。核心修正在于，将stage2工作空间计算中原本使用的`coreParams.get_s1BaseSize() * alignedD`因子，统一替换为`coreParams.get_n2BaseSize() * coreParams.get_s1BaseSize() * alignedD`，从而将`n2`维度的分块大小纳入计算。此修改覆盖了无需切D（`dSize` <= 64）和需要切D（`dSize` > 64）两种场景，确保了工作空间估算的准确性。","created_at":"2026-02-11T11:45:27+08:00","updated_at":"2026-02-11T11:45:27+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.