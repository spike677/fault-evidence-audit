4fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":165190334,"discussion_id":"58c3f18270bc48fb12e081248671e40db9ca8baa","body":"## 问题/功能描述\n\n本次PR主要对量化批处理矩阵乘法（QuantBatchMatmulV3）调度器进行了功能扩展和优化。核心是为调度器增加了A矩阵全载模式（FULL_LOAD_MODE=1）的支持，解决了原有调度策略单一、无法根据数据加载模式进行优化的问题，提升了调度灵活性和潜在性能。同时，移除了在A矩阵全载且多轮切分场景下对尾块切分的不必要限制，以提升硬件资源利用率，并统一了不同内核实现中调度器模板的实例化方式，确保代码一致性。此外，更新了针对Ascend950芯片的测试用例配置，微调了特定场景的平铺参数。\n\n## 修改方案描述\n\n修改方案主要包括三部分：1）将 `QuantBatchMatmulV3Scheduler` 重构为模板类，通过模板参数 `fullLoadMode` 区分全载模式；重构核心调度器 `BlockSchedulerQuantBatchMatmulV3`，在其 `GetBlockShape` 和 `GetTileIdx` 等方法中根据模式调整分块索引和瓦片坐标的计算逻辑，以适配A矩阵全载模式。2）在自适应滑动窗口切分逻辑中，删除了强制禁用尾块切分的限制条件；并在多个内核头文件中将调度器模板参数显式化，统一实例化方式。3）更新了Ascend950芯片的测试配置文件，调整了特定测试场景的平铺参数值。","created_at":"2026-03-13T15:38:55+08:00","updated_at":"2026-03-13T15:38:55+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":165425036,"discussion_id":"7a42467dc242b63005f8b472a0cd56c2c621ec51","body":"/lgtm\n/approve","created_at":"2026-03-16T20:39:42+08:00","updated_at":"2026-03-16T20:39:42+08:00","user":{"id":"6861e48dadc5e31e4da8818d","login":"chenqi317","object_id":"6861e48dadc5e31e4da8818d","name":"chenqi317","avatar_url":"","html_url":"https://gitcode.com/chenqi317"},"comment_type":"pr_comment"},{"id":166602467,"discussion_id":"2e5758f8f2b503db63b9c824afbd2cc199cfe350","body":":large_blue_circle: source code change are detected, tasks labels is removed in this pull request!","created_at":"2026-03-27T14:23:38+08:00","updated_at":"2026-03-27T14:23:38+08:00","user":{"id":"673c1552584