73c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":160776928,"discussion_id":"f265d3cfffe0e94673ae71eaa03ab81480d9019b","body":"/lgtm","created_at":"2026-01-22T09:18:11+08:00","updated_at":"2026-01-22T09:18:11+08:00","user":{"id":"6822c65e59bdd61f837dbc5a","login":"yu-xinjie62","object_id":"6822c65e59bdd61f837dbc5a","name":"於欣洁","html_url":"https://gitcode.com/yu-xinjie62"},"comment_type":"pr_comment"},{"id":160777238,"discussion_id":"84b9a7e6f5fa32bdf118c4216267f65199bd7090","body":"/approve","created_at":"2026-01-22T09:20:26+08:00","updated_at":"2026-01-22T09:20:26+08:00","user":{"id":"6822c62fb3a86414eb5ba260","login":"chen-linxin4","object_id":"6822c62fb3a86414eb5ba260","name":"chen-linxin4","html_url":"https://gitcode.com/chen-linxin4"},"comment_type":"pr_comment"},{"id":160777257,"discussion_id":"ed22cc25bbafc5223b0bebd3cd048925b4d06218","body":"### Review Guide\n\nThis Pull-Request **Passes Review**.\nCommitters who wrote a comment of `/approve` are: [*chen-linxin4*](https://gitcode.com/chen-linxin4).\nReviewers who wrote a comment of `/lgtm` are: [*yu-xinjie62*](https://gitcode.com/yu-xinjie62), [*chen-linxin4*](https://gitcode.com/chen-linxin4).","created_at":"2026-01-22T09:20:33+08:00","updated_at":"2026-01-22T09:20:33+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"}]