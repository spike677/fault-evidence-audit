+        layers = {"plain": SimpleNamespace(impl=object())}
+        kv_caches = {"plain": (MagicMock(), MagicMock())}
+        self._runner(layers)._fill_c8_mxfp_v_scale_caches(kv_caches)
+
+    def test_a_layer_without_a_forward_context_entry_is_skipped(self):
