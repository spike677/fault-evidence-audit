[{"id":8330352,"html_url":"https://gitcode.com/cann/ops-nn/merge_requests/1770","diff_url":"https://gitcode.com/cann/ops-nn/merge_requests/1770/diffs","number":1770,"state":"merged","title":"Fix Embeddingbag paddingIdx_ error","body":"## 描述\nAscend950上embadding bag算子部分用例在测试非连续性通路场景下，会出现精度失败问题\n原因：在使用此算子的时候，上层torch框架已经将paddingIdx由相应负值处理为正值，tiling里的重复处理会导致精度失败。\n修改方案：去除tiling重复处理paddingIdx逻辑\n## 关联的Issue\nhttps://gitcode.com/cann/ops-nn/issues/971\n\n## 测试\nembeddingbag算子，本地白盒验证和网络用例验证均通过。\n\n## 文档更新\n<!--如果这个PR包含文档的更新，请在这里指出。例如：更新了README.md文件。-->\n\n## 类型标签\n<!--  [x] 表示选中 -->\n- [x] Bug修复\n- [ ] 新特性\n- [ ] 性能优化\n- [ ] 文档更新\n- [ ] 其他，请描述：","created_at":"2026-02-10T20:26:51.455+08:00","updated_at":"2026-02-11T14:53:36.299+08:00","merged_at":"2026-02-11T14:53:35.688+08:00","head":{"ref":"fixpadding","sha":"45186b065497e237af76ce2ed4f324493c08966f","repo":{"path":"ops-nn","name":"ops-nn","full_name":"Apricityh/ops-nn"},"assigner":{"login":"Apricityh","name":"Wang Xu"}},"base":{"ref":"master","sha":"baa382abe1a4f917821374aa94569efb1e8f71d7","repo":{"path":"ops-nn","name":"ops-nn","full_name":"cann/ops-nn"}},"assignees":[],"testers":[],"labels":[{"id":22553,"color":"#3ee029","name":"api-check-pass","created_at":"2025-12-16T09:45:21+08:00","updated_at":"2026-02-10T20:39:28+08:00"},{"id":4929,"color":"#2865E0","name":"cann-cla/yes","created_at":"2025-06-21T10:53:09+08:00","updated_at":"2026-02-10T20:27:07+08:00"},{"id":3873,"color":"#21BA45","name":"ci-pipeline-passed","created_at":"2025-06-10T14:17:23+08:00","updated_at":"2026-02-10T20:39:33+08:00"},{"id":2742,"color":"#22ed07","name":"approved","created_at":"2025-05-29T20:14:31+08:00","updated_at":"2026-02-11T11:29:43+08:00"},{"id":2741,"color":"#17f207","name":"lgtm","created_at":"2025-05-29T20:14:01+08:00","updated_at":"2026-02-11T14:53:28+08:00"}],"can_merge_check":true}]