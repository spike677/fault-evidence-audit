+    def _qfa_step_cache(self, attn_metadata: AscendMetadata) -> dict:
+        cache = getattr(attn_metadata, "qfa_metadata_cache", None)
+        if cache is None:
+            cache = {}
+            attn_metadata.qfa_metadata_cache = cache
+        return cache
