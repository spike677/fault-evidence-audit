+
+def _sequence(tensor, layout, batch, length, cumulative=None, table=None):
+    """Gather logical tokens on the original device, retaining their dtype."""
+    if layout == "TND":
+        start = int(cumulative[batch].item())
+        return tensor[start : start + length]
+    if layout == "BSND":
+        return tensor[batch, :length]
+    if layout == "BNSD":
+        return tensor[batch, :, :length].transpose(0, 1)
+    bs = tensor.shape[3 if layout == "PA_NZ" else 1 if layout == "PA_BBND" else 2]
+    pages = tensor.index_select(0, table[batch, : (length + bs - 1) // bs].long())
+    if layout == "PA_BNBD":
+        pages = pages.permute(0, 2, 1, 3)
+    elif layout == "PA_NZ":
+        pages = pages.permute(0, 3, 1, 2, 4).flatten(-2)
+    return pages.reshape(-1, pages.shape[-2], pages.shape[-1])[:length]
+
+
+def _packed_fa3(q, k, v, **kwargs):
+    from flash_attn_interface import flash_attn_varlen_func
+
+    # Zero padding preserves QK scores and V's leading coordinates. Always keep
+    # the original explicit scale rather than recomputing it from padded D.
+    kernel_dim = next(d for d in (64, 128, 256) if d >= max(q.shape[-1], v.shape[-1]))
+    operands = [
+        torch.nn.functional.pad(t, (0, kernel_dim - t.shape[-1]))
+        if t.shape[-1] != kernel_dim
+        else t
+        for t in (q, k, v)
+    ]
+    out, lse = flash_attn_varlen_func(*operands, **kwargs)
+    if out.shape != (*q.shape[:-1], kernel_dim) or lse.shape != (
+        q.shape[1],
+        q.shape[0],
+    ):
+        raise ValueError("FA3 returned incorrect attention/LSE shapes")
+    if out.dtype != q.dtype or lse.dtype != torch.float32:
+        raise ValueError("FA3 must return attention in input dtype and FP32 LSE")
+    if any(torch.isnan(t).any().item() for t in (out, lse)):
+        raise ValueError("FA3 output contains NaN")
+    return out[..., : v.shape[-1]], lse
+
+
+def _fa3_attention(arguments, q_lengths, k_lengths):
+    q, k, v = (arguments[name] for name in ("q", "k", "v"))
+    lq, lk, lo = (arguments[name] for name in ("layout_q", "layout_kv", "layout_out"))
+    nq = q.shape[1 if lq in ("TND", "BNSD") else 2]
+    dv = v.shape[2] * 16 if lk == "PA_NZ" else v.shape[-1]
+    shape = (*q.shape[:-1], dv)
+    output = torch.zeros(shape, dtype=q.dtype, device=q.device)
+    lse_shape = (
+        (nq, q.shape[0])
+        if lq == "TND"
+        else (q.shape[0], nq, q.shape[2 if lq == "BNSD" else 1])
+    )
+    result_lse = torch.full(
+        lse_shape, float("inf"), device=q.device, dtype=torch.float32
+    )
+    active = [
+        b for b, (sq, sk) in enumerate(zip(q_lengths, k_lengths)) if sq > 0 and sk > 0
+    ]
+    if active:
+        direct = (
+            lq == lk == "TND"
+            and arguments["seqused_q"] is None
+            and arguments["seqused_kv"] is None
+            and len(active) == len(q_lengths)
+        )
+        if direct:
+            packed_q, packed_k, packed_v = q, k, v
+            cuq, cuk = arguments["cu_seqlens_q"], arguments["cu_seqlens_kv"]
+        else:
+            packed_q = torch.cat(
+                [
+                    _sequence(q, lq, b, q_lengths[b], arguments["cu_seqlens_q"])
+                    for b in active
+                ]
+            ).contiguous()
+            packed_k, packed_v = [
+                torch.cat(
+                    [
+                        _sequence(
+                            t,
+                            lk,
+                            b,
+                            k_lengths[b],
+                            arguments["cu_seqlens_kv"],
+                            arguments["block_table"],
+                        )
+                        for b in active
+                    ]
+                ).contiguous()
+                for t in (k, v)
+            ]
+            cuq, cuk = [
+                torch.tensor(
+                    [0] + [lengths[b] for b in active],
+                    dtype=torch.int32,
+                    device=q.device,
+                ).cumsum(0, dtype=torch.int32)
+                for lengths in (q_lengths, k_lengths)
+            ]
+        mode = arguments["mask_mode"]
+        window = (
+            (arguments["win_left"], arguments["win_right"]) if mode == 4 else (-1, -1)
+        )
+        out, lse = _packed_fa3(
+            packed_q,
+            packed_k,
+            packed_v,
+            cu_seqlens_q=cuq,
+            cu_seqlens_k=cuk,
+            max_seqlen_q=arguments["max_seqlen_q"]
+            if arguments["max_seqlen_q"] >= 0
+            else max(q_lengths),
+            max_seqlen_k=arguments["max_seqlen_kv"]
+            if arguments["max_seqlen_kv"] >= 0
+            else max(k_lengths),
+            softmax_scale=arguments["softmax_scale"],
+            causal=mode == 3,
+            window_size=window,
+            return_attn_probs=True,
+        )
+        empty_rows = []
+        for b in active:
+            sq, sk = q_lengths[b], k_lengths[b]
+            center = torch.arange(sq, device=q.device) + sk - sq
+            lower = (
+                (center - window[0]).clamp_min(0)
+                if mode == 4 and window[0] >= 0
+                else torch.zeros_like(center)
+            )
+            upper = (
+                center
+                if mode == 3
+                else center + window[1]
+                if mode == 4 and window[1] >= 0
+                else torch.full_like(center, sk - 1)
+            )
+            empty_rows.append(lower > upper.clamp_max(sk - 1))
+        empty = torch.cat(empty_rows)
+        lse = lse.masked_fill(empty[None, :], float("-inf"))
+        sinks = arguments["sinks"]
+        if sinks is not None and sinks.numel():
+            combined = torch.logaddexp(lse, sinks[:, None])
+            out = (out.float() * torch.exp(lse - combined).T.unsqueeze(-1)).to(q.dtype)
+            lse = combined
+        else:
+            lse = lse.masked_fill(empty[None, :], float("inf"))
+        out = out.masked_fill(empty[:, None, None], 0)
+        if any(torch.isnan(t).any().item() for t in (out, lse)):
+            raise ValueError("FA3 sink normalization contains NaN")
+        start = 0
+        for b in active:
+            length = q_lengths[b]
+            if lq == "TND":
+                target = int(arguments["cu_seqlens_q"][b].item())
+                output[target : target + length] = out[start : start + length]
+                result_lse[:, target : target + length] = lse[:, start : start + length]
+            else:
+                if lq == "BSND":
+                    output[b, :length] = out[start : start + length]
+                else:
+                    output[b, :, :length] = out[start : start + length].transpose(0, 1)
+                result_lse[b, :, :length] = lse[:, start : start + length]
+            start += length
+    if lq == "BNSD" and lo == "BSND":
+        output = output.permute(0, 2, 1, 3).contiguous()
+    return output, result_lse if arguments["return_softmax_lse"] else torch.zeros(
+        1, dtype=torch.float32, device=q.device
+    )
+
+
+class FA3ThirdParty:
+    def __call__(
+        self,
+        q,
+        k,
+        v,
+        block_table=None,
+        cu_seqlens_q=None,
+        cu_seqlens_kv=None,
+        seqused_q=None,
+        seqused_kv=None,
+        sinks=None,
+        attn_mask=None,
+        metadata=None,
+        softmax_scale=1.0,
+        mask_mode=0,
+        win_left=-1,
+        win_right=-1,
+        max_seqlen_q=-1,
+        max_seqlen_kv=-1,
+        layout_q="BSND",
+        layout_kv="BSND",
+        layout_out="BSND",
+        return_softmax_lse=False,
+        **kwargs,
+    ):
+        arguments = dict(locals())
+        arguments.pop("self")
+        arguments.pop("kwargs")
+        lengths = _validate_fa3(arguments)
+        if q.device.type != "cuda":
+            raise RuntimeError(
+                "FA3 third party requires CUDA inputs; configure a GPU XPU endpoint"
+            )
+        for name in (
+            "k",
+            "v",
+            "block_table",
+            "cu_seqlens_q",
+            "cu_seqlens_kv",
+            "seqused_q",
+            "seqused_kv",
+            "sinks",
+        ):
+            value = arguments[name]
+            if value is not None and value.device != q.device:
+                raise ValueError(f"{name} must be on the same CUDA device as Q")
+        with torch.no_grad():
+            return _fa3_attention(arguments, *lengths)
