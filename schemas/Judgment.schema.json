{
  "$defs": {
    "ApplicableIssue": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "selection_reason": {
          "minLength": 1,
          "title": "Selection Reason",
          "type": "string"
        }
      },
      "required": [
        "label",
        "evidence",
        "selection_reason"
      ],
      "title": "ApplicableIssue",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "quote"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FactComparison": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "NUMBER",
            "TERM",
            "SCENARIO",
            "TECHNICAL_CONCLUSION"
          ],
          "title": "Category",
          "type": "string"
        },
        "source_field": {
          "default": "",
          "title": "Source Field",
          "type": "string"
        },
        "source_quote": {
          "default": "",
          "title": "Source Quote",
          "type": "string"
        },
        "source_cell": {
          "default": "",
          "title": "Source Cell",
          "type": "string"
        },
        "source_value": {
          "default": "",
          "title": "Source Value",
          "type": "string"
        },
        "evidence_value": {
          "default": "",
          "title": "Evidence Value",
          "type": "string"
        },
        "source_meaning": {
          "default": "",
          "title": "Source Meaning",
          "type": "string"
        },
        "evidence_meaning": {
          "default": "",
          "title": "Evidence Meaning",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "relation": {
          "enum": [
            "MATCH",
            "CONFLICT",
            "UNKNOWN",
            "NAME_ONLY",
            "DIFFERENT"
          ],
          "title": "Relation",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "category",
        "relation"
      ],
      "title": "FactComparison",
      "type": "object"
    },
    "NegativeBasis": {
      "additionalProperties": false,
      "properties": {
        "other_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegativeIdentityBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attribution_mismatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegativeIdentityBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "NegativeBasis",
      "type": "object"
    },
    "NegativeIdentityBasis": {
      "additionalProperties": false,
      "description": "A producer-declared positive identity statement, never an inferred gap.\n\nThe gate checks structure and exact source grounding. Human review still\ndecides whether the declared identity/ownership semantics are justified.",
      "properties": {
        "positive_identity": {
          "minLength": 1,
          "title": "Positive Identity",
          "type": "string"
        },
        "context": {
          "minLength": 16,
          "title": "Context",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "enum": [
              "event_identity",
              "ownership",
              "symptom",
              "occurrence_context",
              "explicit_exclusion"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Dimensions",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "positive_identity",
        "context",
        "dimensions",
        "evidence"
      ],
      "title": "NegativeIdentityBasis",
      "type": "object"
    },
    "SelfCheck": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "maximum": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "numeric_meaning_checked": {
          "title": "Numeric Meaning Checked",
          "type": "boolean"
        },
        "citations_checked": {
          "title": "Citations Checked",
          "type": "boolean"
        },
        "counterevidence_checked": {
          "title": "Counterevidence Checked",
          "type": "boolean"
        },
        "issue_scope_checked": {
          "title": "Issue Scope Checked",
          "type": "boolean"
        },
        "event_vs_technical_checked": {
          "title": "Event Vs Technical Checked",
          "type": "boolean"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "attempt",
        "numeric_meaning_checked",
        "citations_checked",
        "counterevidence_checked",
        "issue_scope_checked",
        "event_vs_technical_checked",
        "passed"
      ],
      "title": "SelfCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "case_attribution": {
      "enum": [
        "CONFIRMED",
        "PARTIAL",
        "UNKNOWN",
        "MISMATCH"
      ],
      "title": "Case Attribution",
      "type": "string"
    },
    "event_relation": {
      "enum": [
        "SAME_EVENT",
        "DIFFERENT_EVENT",
        "UNDETERMINED"
      ],
      "title": "Event Relation",
      "type": "string"
    },
    "pattern_relation": {
      "enum": [
        "SAME_PATTERN",
        "DIFFERENT_PATTERN",
        "POSSIBLY_RELATED",
        "UNDETERMINED"
      ],
      "title": "Pattern Relation",
      "type": "string"
    },
    "support_level": {
      "enum": [
        "DIRECT",
        "PARTIAL",
        "INDIRECT",
        "NONE",
        "PENDING",
        "CONFLICT"
      ],
      "title": "Support Level",
      "type": "string"
    },
    "claim_support": {
      "additionalProperties": {
        "enum": [
          "SUPPORTED",
          "PARTIAL",
          "CONTRADICTED",
          "NOT_MENTIONED",
          "UNKNOWN"
        ],
        "type": "string"
      },
      "title": "Claim Support",
      "type": "object"
    },
    "matched_dimensions": {
      "items": {
        "type": "string"
      },
      "title": "Matched Dimensions",
      "type": "array"
    },
    "conflicting_dimensions": {
      "items": {
        "type": "string"
      },
      "title": "Conflicting Dimensions",
      "type": "array"
    },
    "unknown_dimensions": {
      "items": {
        "type": "string"
      },
      "title": "Unknown Dimensions",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "event_anchor": {
      "default": "",
      "title": "Event Anchor",
      "type": "string"
    },
    "negative_basis": {
      "anyOf": [
        {
          "$ref": "#/$defs/NegativeBasis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observation_scope": {
      "default": "CAPTURED_CONTENT",
      "enum": [
        "CAPTURED_CONTENT",
        "FULL_DOCUMENT"
      ],
      "title": "Observation Scope",
      "type": "string"
    },
    "fact_comparisons": {
      "items": {
        "$ref": "#/$defs/FactComparison"
      },
      "title": "Fact Comparisons",
      "type": "array"
    },
    "applicable_issue": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApplicableIssue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "self_check": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelfCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "short_reason": {
      "title": "Short Reason",
      "type": "string"
    },
    "missing_information": {
      "items": {
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "model_mode": {
      "title": "Model Mode",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "snapshot_id",
    "case_attribution",
    "event_relation",
    "pattern_relation",
    "support_level",
    "short_reason",
    "model_mode",
    "model_id"
  ],
  "title": "Judgment",
  "type": "object"
}
