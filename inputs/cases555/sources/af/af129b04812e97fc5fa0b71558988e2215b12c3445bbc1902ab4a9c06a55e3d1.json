55691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":158995362,"discussion_id":"253a1472756e6aed1ebb4e39e16b51072ff92057","body":":large_blue_circle: source code change are detected, tasks labels is removed in this pull request!","created_at":"2026-01-06T18:06:31+08:00","updated_at":"2026-01-06T18:06:31+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":158995374,"discussion_id":"178975f37293f3b1feb559b1a652b0dececc9c1b","body":"compile","created_at":"2026-01-06T18:06:36+08:00","updated_at":"2026-01-06T18:06:36+08:00","user":{"id":"67151ae4f4dcc859ed53531a","login":"oscillated","object_id":"67151ae4f4dcc859ed53531a","name":"oscillated","avatar_url":"https://cdn-img.gitcode.com/ac/df/0739acdfb93c2f17b6f32f89c5e61d0a3c14c442980a22b2d8bd7f14690eaa8d.png","html_url":"https://gitcode.com/oscillated"},"comment_type":"pr_comment"},{"id":158995388,"discussion_id":"18cd30178decef53663e029f41b4b98939d58f01","body":"## 问题/功能描述\n\n修复了在特定硬件平台（910B/910C）和特定配置（使用aclnnbaddbmm接口、fp16/bf16输入、CubeMathType==KEEP_DTYPE）下，批量矩阵乘法（BatchMatMul）算子输出数据类型转换逻辑错误的问题。该问题导致在上述混精度计算场景下，输出张量的数据类型被错误地转换为FP32，而非预期的输出数据类型。\n\n## 修改方案描述\n\n修改了批量矩阵乘法算子执行函数`ExecBatchMatmulOpWithBiasAndAttrs`中，将计算结果转换为输出数据类型的逻辑。核心修改是新增了一个条件判断：当检测到启用`enableFp16Bf16InFp32Out`标志（即混精度接口场景）时，跳过将`transdataOut`转换为`out->GetDataType()`的步骤，而是直接将其转换为`DT_FLOAT`类型。这确保了与底层混精度计算接口的输出类型一致，从而保证了最终结果的正确性。","created_at":"2026-01-06T18:06:52+08:00","updated_at":"2026-01-06T18:06:52+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":158995426,"discussion_id":"066558e67ad268b748d93814ca05de8ebe375746","body":"### 指针与引用安全: 在函数`ExecBatchMatmulOpWithBiasAndAttrs`中，当`isTransposeMat2Contiguous`为true时，`mat2Cast`被赋值为`executor->CreateView(...)`的结果。虽然`CreateView`函数可能返回一个有效的指针，但后续立即调用`SetTensorToNDFormat(mat2Cast)`，该函数内部对`mat2Cast`进行了`const_cast<aclTensor*>(input)`操作，并可能修改其内部状态。然而，`CreateView`返回的是`const aclTensor*`，而`SetTensorToNDFormat`内部将其转换为非const指针并进行修改，这违反了const正确性，可能导致未定义行为。此外，如果`CreateView`返回nullptr（例如在内存不足或参数无效时），`SetTensorToNDFormat`将解引用空指针，导致程序崩溃。\n\n**问题类型**: 指针与引用安全\n**文件路径**: `matmul/batch_mat_mul_v3/op_host/op_api/aclnn_batch_matmul.cpp`\n**行号**: 688\n**问题代码**:\n```cpp\n        mat2Cast = executor->CreateView(mat2, mat2->GetViewShape(), mat2->GetStorageShape(), mat2->GetViewStrides(), mat2->GetViewOffset());\n        mat2Cast = SetTensorToNDFormat(mat2Cast);\n```\n**修改建议**:\n```\n1. 在调用`SetTensorToNDFormat`之前，检查`mat2Cast`是否为nullptr。\n2. 考虑重构`SetTensorToNDFormat`函数，使其接受`const aclTensor*`并返回一个新的`const aclTensor*`，而不是修改输入参数。如果必须修改，应确保输入参数是非const的，或者使用更安全的方式。\n3. 或者，将`CreateView`的返回值存储在一个临时变量中，判空后再传递给`SetTensorToNDFormat`。\n```\n\n---\n*此评论由代码审查工具自动生成*","created_at":"2026-01-06T18:07:13+08:00","updated_at":"2026-01-06T18:07:13+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"diff_comment","resolved":false,"diff_position":{"start_new_line":688,"end_new_line":688,"position_type":"text"},"reply":[{"id":159025762,"body":"changed this line on [cce524a8](https://gitcode.com/cann/ops-nn/commits/detail/cce524a81e0881d852ba6f973ddab7cc66df0aee?ref=master&prId=643) view [diff detail](https://gitcode.com/cann/ops-nn/merge_requests/