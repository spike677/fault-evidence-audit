+def test_spec_import_without_ttk_or_npu():
+    import subprocess
+
+    code = """
+import importlib.abc
+import os
+import sys
+os.environ['TORCH_DEVICE_BACKEND_AUTOLOAD'] = '0'
+class BlockFramework(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname.split('.')[0] in ('ttk', 'torch_npu', 'cann_ops_transformer'):
+            raise AssertionError('unexpected framework import: ' + fullname)
+sys.meta_path.insert(0, BlockFramework())
+sys.path.insert(0, sys.argv[1])
+from spec import FlashAttnSpec
+assert FlashAttnSpec.third_party['torch'].__name__ == 'FA3ThirdParty'
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", code, str(ASSETS)], capture_output=True, text=True
+    )
+    assert result.returncode == 0, result.stderr
+
+
+def packed_fp64_fa3(q, k, v, **kwargs):
+    """CPU stand-in for FA3 only; independently compute its packed ABI in FP64."""
+    outs, lses = [], []
+    cuq, cuk = kwargs["cu_seqlens_q"].tolist(), kwargs["cu_seqlens_k"].tolist()
+    assert q.shape[-1] in (64, 128, 256) and k.shape[-1] == v.shape[-1] == q.shape[-1]
+    for qs, qe, ks, ke in zip(cuq, cuq[1:], cuk, cuk[1:]):
+        nq, nk = q.shape[1], k.shape[1]
+        qb = q[qs:qe].double().transpose(0, 1)
+        kb = k[ks:ke].double().repeat_interleave(nq // nk, dim=1).transpose(0, 1)
+        vb = v[ks:ke].double().repeat_interleave(nq // nk, dim=1).transpose(0, 1)
+        scores = (qb @ kb.transpose(-2, -1)) * kwargs["softmax_scale"]
+        center = torch.arange(qe - qs)[:, None] + (ke - ks) - (qe - qs)
+        keys = torch.arange(ke - ks)[None, :]
+        left, right = kwargs["window_size"]
+        mask = torch.zeros_like(center + keys, dtype=torch.bool)
+        if kwargs["causal"]:
+            mask |= keys > center
+        if left >= 0:
+            mask |= keys < center - left
+        if right >= 0:
+            mask |= keys > center + right
+        scores.masked_fill_(mask[None], -torch.inf)
+        lse = scores.logsumexp(-1)
+        empty = torch.isneginf(lse)
+        weights = torch.exp(scores - lse[..., None]).masked_fill(empty[..., None], 0)
+        outs.append((weights @ vb).transpose(0, 1))
+        lses.append(lse.masked_fill(empty, torch.inf))
+    return torch.cat(outs).to(q.dtype), torch.cat(lses, dim=1).float()
+
+
+_SCOPE_ROWS = list(
+    csv.DictReader((ASSETS / "testcase/flash_attn_fa3_scope.csv").open())
+)
