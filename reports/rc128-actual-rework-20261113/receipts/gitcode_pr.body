hotline":1295,"launchDate":1296,"launchDesc1":1297,"launchDesc2":1298,"launchDesc3":1299,"modeFreeze":1300,"modes":1301,"noDataLoss":1302,"noReconfig":1303,"officialLaunch":1304,"optimizeAndLet":1305,"permissionsUnchanged":1306,"title":1307,"unifiedModel":1308,"upgradeTimeline":1309,"whatsNew":1310},"Developers: AtomGit's upcoming permission upgrade deprecates inheritance\u002Findependent mode, bringing you clearer, more intuitive management post-upgrade.","Clearer Member Sources and More Intuitive Management","If you have any questions","Click to Contact Online Customer Service","Contact Us","Your current member data and permission settings remain unchanged.","Customer Service Email","Members from projects",".","clear source attribution at a glance","This update is fully compatible with existing data","are unaffected","Unified management entry and operation rules","adding members directly","No more distinction between independent and inherited modes","unified rules that are clear and predictable.","upper-level passes through","Clearer Member Sources","Data Compatibility Guaranteed","Unified Management","Unified Permission Rules","Changes cease","Got It","Customer Service Hotline","Launches on August 1","New member permission model launches","Member list displayed in tabs by source","original Independent Mode and Inherited Mode are removed","Mode Freeze","Independent Mode and Inherited Mode","No Data Loss","No Reconfiguration Needed","Official Launch",", Optimize the display and management rules of member lists, and let","Permissions Unchanged","Member Permission Model Upgrade","Unified Member Permission Model","Upgrade Timeline","What's New",{"code":1312,"detail":1316,"list":1320,"repo":1327},{"blame":1313,"branch":1314,"fileFinder":1315},"View blame","Switch branch","Go to file",{"quote":1317,"related":1318,"reviewer":1319},"Quote selection","Related pull requests","Reviewers",{"assignee":1321,"author":1322,"create":1323,"label":1324,"milestone":1325,"search":1326