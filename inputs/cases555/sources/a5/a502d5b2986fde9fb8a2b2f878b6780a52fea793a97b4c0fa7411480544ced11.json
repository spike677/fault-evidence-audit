[{"id":8543068,"html_url":"https://gitcode.com/cann/ops-nn/merge_requests/4151","diff_url":"https://gitcode.com/cann/ops-nn/merge_requests/4151/diffs","number":4151,"state":"merged","title":"[conv]dx支持超大累加轴","body":"## 描述\n\n<!--在这里详细描述你的改动，包括改动的原因和所采取的方法。-->\n卷积反向dx算子支持超大累加轴，通过对累加轴在一定累加数量阈值内切分，将l0c的结果分段搬出到GM（workspace）上累加，避免由于在l0c上多次累加而存在的大数吃小数的场景。\n## 关联的Issue\n<!-- 如果这个PR是为了解决特定的Issue，请在这里提供Issue链接。例如：关联Issue #000-->\nhttps://gitcode.com/cann/ops-nn/issues/2338\n## 测试\n<!--描述进行了哪些测试来验证你的改动。-->\nRDV、TilingHkWk门槛用例、超大Cout轴用例\n## 文档更新\n<!--如果这个PR包含文档的更新，请在这里指出。例如：更新了README.md文件。-->\n无\n## 类型标签\n<!--  [x] 表示选中 -->\n- [x] Bug修复\n- [ ] 新特性\n- [ ] 性能优化\n- [ ] 文档更新\n- [ ] 其他，请描述：\n","created_at":"2026-04-23T18:50:19.467+08:00","updated_at":"2026-04-27T16:30:56.833+08:00","merged_at":"2026-04-27T16:07:05.953+08:00","head":{"ref":"split_hk_new_test","sha":"5109e0e63cbb34c210da3d1a68aa2185573bfdfa","repo":{"path":"ops-nn","name":"ops-nn","full_name":"linruihan/ops-nn"},"assigner":{"login":"linruihan","name":"linruihan"}},"base":{"ref":"master","sha":"4ae35c5096e13b1cb3f963a338e1d945f1b1cbde","repo":{"path":"ops-nn","name":"ops-nn","full_name":"cann/ops-nn"}},"assignees":[],"testers":[],"labels":[{"id":4929,"color":"#2865E0","name":"cann-cla/yes","created_at":"2025-06-21T10:53:09+08:00","updated_at":"2026-04-23T18:50:30+08:00"},{"id":3873,"color":"#21BA45","name":"ci-pipeline-passed","created_at":"2025-06-10T14:17:23+08:00","updated_at":"2026-04-27T15:19:57+08:00"},{"id":22553,"color":"#3ee029","name":"api-check-pass","created_at":"2025-12-16T09:45:21+08:00","updated_at":"2026-04-27T15:19:14+08:00"},{"id":2742,"color":"#22ed07","name":"approved","created_at":"2025-05-29T20:14:31+08:00","updated_at":"2026-04-27T16:05:15+08:00"},{"id":2741,"color":"#17f207","name":"lgtm","created_at":"2025-05-29T20:14:01+08:00","updated_at":"2026-04-27T16:06:53+08:00"}],"can_merge_check":true}]