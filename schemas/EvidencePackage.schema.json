{
  "$defs": {
    "PageObservation": {
      "additionalProperties": false,
      "description": "Collector observations; page quality is not inferred from text length.",
      "properties": {
        "page_kind": {
          "enum": [
            "BODY",
            "INDEX",
            "TITLE_ONLY",
            "LOGIN",
            "FORBIDDEN",
            "RENDER_PENDING",
            "EXTRACTION_FAILED",
            "UNRELATED"
          ],
          "title": "Page Kind",
          "type": "string"
        },
        "requested_url": {
          "minLength": 1,
          "title": "Requested Url",
          "type": "string"
        },
        "final_url": {
          "minLength": 1,
          "title": "Final Url",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "body_locator": {
          "default": "",
          "title": "Body Locator",
          "type": "string"
        },
        "body_quotes": {
          "items": {
            "type": "string"
          },
          "title": "Body Quotes",
          "type": "array"
        },
        "observed_by": {
          "minLength": 1,
          "title": "Observed By",
          "type": "string"
        },
        "observed_at": {
          "minLength": 1,
          "title": "Observed At",
          "type": "string"
        },
        "tool_observation": {
          "minLength": 1,
          "title": "Tool Observation",
          "type": "string"
        }
      },
      "required": [
        "page_kind",
        "requested_url",
        "final_url",
        "observed_by",
        "observed_at",
        "tool_observation"
      ],
      "title": "PageObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    },
    "text": {
      "default": "",
      "title": "Text",
      "type": "string"
    },
    "status": {
      "default": "COMPLETE",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "AUTH_REQUIRED",
        "FORBIDDEN",
        "NOT_FOUND",
        "TIMEOUT",
        "PARSE_FAILED",
        "UNSUPPORTED",
        "NOT_FETCHED",
        "NETWORK_BLOCKED",
        "CONTENT_CAPTURED"
      ],
      "title": "Status",
      "type": "string"
    },
    "components": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Components",
      "type": "object"
    },
    "artifact_type": {
      "default": "GENERIC",
      "enum": [
        "GENERIC",
        "WIKI",
        "DTS",
        "PR"
      ],
      "title": "Artifact Type",
      "type": "string"
    },
    "required_components": {
      "items": {
        "type": "string"
      },
      "title": "Required Components",
      "type": "array"
    },
    "expected_file_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected File Count"
    },
    "captured_file_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Captured File Count"
    },
    "retrieved_by": {
      "default": "manual-import",
      "title": "Retrieved By",
      "type": "string"
    },
    "retrieved_at": {
      "title": "Retrieved At",
      "type": "string"
    },
    "derived_from": {
      "items": {
        "type": "string"
      },
      "title": "Derived From",
      "type": "array"
    },
    "is_synthetic": {
      "default": false,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Case Ids",
      "type": "array"
    },
    "origin": {
      "default": "HUMAN_ADDED",
      "title": "Origin",
      "type": "string"
    },
    "raw_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw File"
    },
    "requested_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Url"
    },
    "final_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Url"
    },
    "record_discovery": {
      "default": false,
      "title": "Record Discovery",
      "type": "boolean"
    },
    "discovery_query": {
      "default": "",
      "title": "Discovery Query",
      "type": "string"
    },
    "discovered_from_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discovered From Url"
    },
    "capture_observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "url"
  ],
  "title": "EvidencePackage",
  "type": "object"
}
