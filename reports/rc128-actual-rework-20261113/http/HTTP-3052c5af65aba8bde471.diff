+def make_case(dtype, layout="BSND", mask=0, sinks=False, paged=False):
+    generator = torch.Generator().manual_seed(123)
+    q = torch.randn(2, 3, 4, 16, generator=generator, dtype=dtype)
+    k = torch.randn(2, 5, 2, 16, generator=generator, dtype=dtype)
+    v = torch.randn(2, 5, 2, 8, generator=generator, dtype=dtype)
+    dense = (q.clone(), k.clone(), v.clone())
+    args = {
+        name: param.default
+        for name, param in inspect.signature(golden.cpu_flash_attn).parameters.items()
+        if param.default is not inspect.Parameter.empty and name != "_unused"
+    }
+    args.update(
+        q=q,
+        k=k,
+        v=v,
+        softmax_scale=0.25,
+        mask_mode=mask,
+        win_left=1,
+        win_right=0,
+        layout_q=layout,
+        layout_kv=layout,
+        layout_out=layout,
+        return_softmax_lse=True,
+        seqused_q=torch.tensor([3, 2]),
+        seqused_kv=torch.tensor([5, 4]),
+        sinks=torch.tensor([0.2, -0.3, 0.1, 0.4]) if sinks else None,
+    )
+    if layout == "BNSD":
+        for name in ("q", "k", "v"):
+            args[name] = args[name].transpose(1, 2).contiguous()
+    elif layout == "TND":
+        for name in ("q", "k", "v"):
+            args[name] = args[name].flatten(0, 1)
+        args["cu_seqlens_q"] = torch.tensor([0, 3, 6])
+        args["cu_seqlens_kv"] = torch.tensor([0, 5, 10])
+    if paged:
+        for name, original in zip(("k", "v"), dense[1:]):
+            padded = torch.zeros(2, 8, 2, original.shape[-1], dtype=dtype)
+            padded[:, :5] = original
+            args[name] = padded.reshape(4, 4, 2, original.shape[-1]).flip(0)
+        args["block_table"] = torch.tensor([[3, 2], [1, 0]])
+        args["layout_kv"] = "PA_BBND"
+    return args, dense
+
+
+def oracle(args, dense):
+    q, k, v = (value.double() for value in dense)
+    out = torch.zeros(2, 3, 4, 8, dtype=torch.float64)
+    lse = torch.full((2, 4, 3), float("inf"), dtype=torch.float64)
+    for batch, (sq, sk) in enumerate(zip(args["seqused_q"], args["seqused_kv"])):
+        sq, sk = int(sq), int(sk)
+        if sq == 0 or sk == 0:
+            continue
+        for head in range(4):
+            scores = q[batch, :sq, head] @ k[batch, :sk, head // 2].T * 0.25
+            qi = torch.arange(sq)[:, None] + sk - sq
+            ki = torch.arange(sk)[None, :]
+            if args["mask_mode"] == 3:
+                scores.masked_fill_(ki > qi, float("-inf"))
+            elif args["mask_mode"] == 4:
+                scores.masked_fill_((ki < qi - 1) | (ki > qi), float("-inf"))
+            values = v[batch, :sk, head // 2]
+            if args["sinks"] is not None:
+                scores = torch.cat(
+                    (scores, args["sinks"][head].double().expand(sq, 1)), 1
+                )
+                values = torch.cat((values, torch.zeros(1, 8, dtype=torch.float64)))
+            out[batch, :sq, head] = torch.nan_to_num(scores.softmax(-1)) @ values
+            row_lse = scores.logsumexp(-1)
+            lse[batch, head, :sq] = row_lse.masked_fill(
+                torch.isneginf(row_lse), float("inf")
+            )
+    if args["layout_q"] == "BNSD":
+        out = out.transpose(1, 2)
+    elif args["layout_q"] == "TND":
+        out = out.flatten(0, 1)
+        lse = lse.permute(1, 0, 2).reshape(4, 6)
+    return out, lse
+
