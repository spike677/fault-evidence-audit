040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":164679421,"discussion_id":"463e4329d7ed40b91958ef2b95d3be02d9c383e3","body":":large_blue_circle: source code change are detected, tasks labels is removed in this pull request!","created_at":"2026-03-09T16:13:53+08:00","updated_at":"2026-03-09T16:13:53+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":164679433,"discussion_id":"48d94613d565d77ec220e0cc2530fbece9d64cce","body":"### CLA Signature Pass  \n zoujiamin123, thanks for your pull request. All authors of the commits have signed the CLA. :+1: ","created_at":"2026-03-09T16:13:56+08:00","updated_at":"2026-03-09T16:13:56+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":164679802,"discussion_id":"e2d8ba01d4e4da65e33aae3b7de477e69a12365a","body":"## 问题/功能描述\n\n修复了在特定量化配置下，MXFP8量化路径的条件编译检查错误。该错误导致当输入数据类型为bfloat16或half，且期望的输出数据类型为fp8_e5m2时，正确的量化操作无法被编译和启用，从而影响模型在特定精度配置下的正确运行。\n\n## 修改方案描述\n\n修改了`moe_init_routing_v3`内核函数中MXFP8量化路径的条件编译检查逻辑。将检查输出数据类型是否为`fp8_e5m2_t`的条件，从错误地引用输入数据类型变量`DTYPE_X`更正为引用扩展输出数据类型变量`DTYPE_EXPANDED_X`。此修改确保了从bfloat16/half到fp8_e5m2的MXFP8量化路径能够被正确编译，从而调用相应的量化算子。","created_at":"2026-03-09T16:15:41+08:00","updated_at":"2026-03-09T16:15:41+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","av