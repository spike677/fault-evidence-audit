+    args, dense = make_case(dtype, layout, mask, sinks, paged)
+    actual = golden._run_reference(reference.FP64Reference, args)
+    for result, expected in zip(actual, oracle(args, dense)):
+        assert result.dtype == torch.float64
+        torch.testing.assert_close(result, expected, rtol=1e-12, atol=1e-12)
