d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":164973957,"discussion_id":"2ed5a43143c9d9e77028b8ce5513cc8a0e1db2fc","body":"## 问题/功能描述\n\n本次PR旨在修复`repeat_interleave`算子在处理尾部数据块时可能出现的输出数据复制逻辑错误。原实现在特定条件下存在缺陷，导致数据处理结果可能不正确。通过本次优化，提升了该算子在边缘场景下的正确性，并增强了代码逻辑的清晰度。\n\n## 修改方案描述\n\n核心修改是重构了`CopyXToMatchOut`和`ProcessCpMatchToUb`两个函数中的数据复制流程。移除了原实现中基于`copyToMatchOutNum_`计数的复杂条件判断，改为在处理完每个数据块后统一执行`CopyMatchOutToY`操作。同时，将输出队列的Tensor分配与入队操作移至条件判断之外，确保输出缓冲区的正确管理，从而简化了控制流，消除了潜在的分支错误。","created_at":"2026-03-11T19:41:34+08:00","updated_at":"2026-03-11T19:41:34+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":164974145,"discussion_id":"e32230cb2f2af5302e26693715c6338905d468d4","body":"compile","created_at":"2026-03-11T19:43:34+08:00","updated_at":"2026-03-11T19:43:34+08:00","user":{"id":"684598ba4229be333029be60","login":"yourealize","object_id":"684598ba4229be333029be60","name":"陈展熹","html_url":"https://gitcode.com/yourealize"},"comment_type":"pr_comment"},{"id":164974233,"discussion_id":"7dc523532eb72489530fbcc6367fb1ba7d77ae28","body":"流水线任务触发成功\n任务链接 [<b><a href='https://www.openlibing.com/apps/pipelineDetail?pipelineId=b582e6c0e2c54a3f8168601c5b292c24&pipelineRunId=0725ac77f026465fb27fff6a4cbaf083&projectName=CANN'>0725ac77f026465fb27fff6a4cbaf083</a></b>][<b><a href='https://gitcode.com/cann/infrastructure/blob/main/docs/ci/ci_guide.md'>流水线指导</a></b>]\n<table style=\"border-collapse: collapse\"><tr><th>任务名称</th><th>状态</th><th>日志</th><th>下载链接</th></tr>\n                    <tr>\n                        <td><strong>解析CI分支</strong></td>\n                        <td>✅ SUCCESS</td>\n   