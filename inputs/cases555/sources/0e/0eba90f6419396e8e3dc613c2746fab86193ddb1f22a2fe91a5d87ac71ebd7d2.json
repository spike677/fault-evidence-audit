be66acb35305ce59007d28029609b5e4b9652.png?time=1777513981052","html_url":"https://gitcode.com/atomgit-bot"},"comment_type":"diff_comment","resolved":false,"diff_position":{"start_new_line":225,"end_new_line":225,"position_type":"text"},"reply":[{"id":179265387,"body":"提交已更新，已解决","created_at":"2026-07-09T16:10:23+08:00","updated_at":"2026-07-09T16:10:23+08:00","user":{"id":"66f7a744eed595591d133945","login":"gh_M","object_id":"66f7a744eed595591d133945","name":"梅国晗954517","avatar_url":"https://cdn-img.gitcode.com/ee/ea/e4154ee0aaa320dd0dc2b2e1d84a2b68466b61f1b6504eb901699f92339d74bc.jpg","html_url":"https://gitcode.com/gh_M"}}]},{"id":178927122,"discussion_id":"176a0675ead17414890c21ceb194eeac9cb97858","body":"\uD83D\uDD34 **Critical**\n\nchanged line → 178: `return l0op::StatelessNormal(selfContiguous, seed, offset, meanTensor, stdTensor, executor);`\n\n旧代码在该路径中通过 `l0op::BroadcastTo` 将标量 mean/std 张量广播到 output shape 后再传入 `StatelessNormal`。新代码直接传入标量张量（`meanVector` / `stdVector` 各仅含 1 个元素），跳过了广播步骤。\n\n`StatelessNormal` kernel 的 tiling 代码（`stateless_normal_tiling_arch35.cpp` 第 90–98 行）明确要求 `meanSize == outputSize`，注释写明 \"L2 已完成广播\"。传入标量张量时，对于任何 outputSize > 1 的 shape，`meanSize=1 != outputSize` 会触发 `GRAPH_FAILED`，导致运行时失败。\n\nfailure mode：当 DAV_3510 平台上 selfContiguous 的 dtype 非 DT_DOUBLE 且输出 shape 元素数 > 1 时，kernel 编译/tiling 阶段报错 `\"StatelessNormal requires mean shapeSize == output shapeSize\"`。\n\nsuggested fix：在调用 `StatelessNormal` 之前，对 `meanTensor` 和 `stdTensor` 执行 `BroadcastTo` 到 `selfContiguous->GetViewShape()`，与旧代码一致。","created_at":"2026-07-07T16:53:48+08:00","updated_at":"2026-07-07T16:53:48+08:00","user":{"id":"672dd45c4ea6673461aa2102","login":"atomgit-bot","object_id":"672dd45c4ea6673461aa2102","name":"atomgit-bot","avatar_url":"https://cdn-img.gitcode.com/fb/bb/88f9bbb284ce2dc057d85551b1bbe66acb35305ce59007d28029609b5e4b9652.png?time=1777513981052","html_url":"https://gitcode.com/atomgit-bot"},"comment_type":"diff_comment","resolved":false,"diff_position":{"start