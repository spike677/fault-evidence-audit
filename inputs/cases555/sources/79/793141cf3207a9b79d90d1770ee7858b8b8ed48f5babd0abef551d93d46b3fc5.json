1472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":159986560,"discussion_id":"3a7f580aa5056e2db61066eecf5ba2a4be1a12be","body":"### CLA Signature Pass  \n wangbairu, thanks for your pull request. All authors of the commits have signed the CLA. :+1: ","created_at":"2026-01-14T17:00:15+08:00","updated_at":"2026-01-14T17:00:15+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":159986570,"discussion_id":"6e209d2c9c1469cfa015ca93ddaf0f4a2c318e6b","body":":large_blue_circle: source code change are detected, tasks labels is removed in this pull request!","created_at":"2026-01-14T17:00:16+08:00","updated_at":"2026-01-14T17:00:16+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":159986648,"discussion_id":"93d3487957d41fa02401714b7e7cf22c606a130f","body":"compile","created_at":"2026-01-14T17:00:36+08:00","updated_at":"2026-01-14T17:00:36+08:00","user":{"id":"67568c09b89449347da5fbc4","login":"wangbairu","object_id":"67568c09b89449347da5fbc4","name":"wangbairu ","avatar_url":"https://cdn-img.gitcode.com/bd/fa/b3330534df7938af96d19bfc027f897f2f763e2370c58e23f7187afb9a3bb6df.png","html_url":"https://gitcode.com/wangbairu"},"comment_type":"pr_comment"},{"id":159986817,"discussion_id":"d17a7c11cda9b6c27a70b1abbb87381178a7b8d3","body":"## 问题/功能描述\n\n本PR包含两项主要变更。第一项是优化卷积反向传播（Convolution Backward）操作在特定场景下的输出后处理逻辑，解决了当输出张量数据类型为FP32且满足特定条件时，原有路径存在冗余数据类型转换的问题，旨在提升处理效率。第二项是精简卷积反向传播算子的单元测试集，移除了多个冗余或针对特定硬件架构的测试用例，以聚焦核心功能验证并提升测试执行效率。\n\n## 修改方案描述\n\n针对性能优化，修改了`OutputPostProcess`函数中的处理逻辑。原先在`needSpecialCast`场景下，无论输出数据类型为何，都统一执行强制转换到FP16再转回原始类型的流程。修改后，根据输出张量的数据类型进行分支：若为FP32则保持原流程；若为其他类型（如FP16），则优化为先转换到目标数据类型再进行数据重排，消除了不必要的中间转换步骤。针对测试精简，通过删除`test_aclnn_convolutin_backward.cpp`文件中的多个`TEST_F`用例，移除了针对特定填充、特定硬件架构以及数据类型不一致组合等场景的测试，保留了所有核心功能验证用例。","created_at":"2026-01-14T17:01:15+08:00","updated_at":"2026-01-14T17:01:15+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":159989141,"discussion_id":"1c3fc12ab099e126712e1d25ee00764182b75a83","body":"compile","created_at":"2026-01-14T17:11:01+08:00","updated_at":"2026-01-14T17:11:01+08:00","user":{"id":"67568c09b89449347da5fbc4","login":"wangbairu","object_id":"67568c09b89449347da5fbc4","name":"wangbairu ","avatar_url":"https://cdn-img.gitcode.com/bd/fa/b3330534df7938af96d19bfc027f897f2f763e2370c58e23f7187afb9a3bb6df.png","html_url":"https://gitcode.com/wangbairu"},"comment_type":"pr_comment"},{"id":159989292,"discussion_id":"c9f1e2358c04c0c231395443ddd456b1fd8329f4","body":"流水线任务触发成功，任务链接 [<b><a href='https://www.openlibing.com/apps/pipelineDetail?pipelineId=b582e6c0e2c54a3f8168601c5b292c24&pipelineRunId=58694f4432414051bdcb027c3403ace8&projectName=CANN'>58694f4432414051bdcb027c3403ace8</a></b>]\n<table style=\"border-collapse: collapse\"><tr><th>任务名称</th><th>状态</th><th>日志</th><th>下载链接</th></tr>\n                        <tr>\n                            <td><strong>codecheck</strong></td>\n                            <td>✅ SUCCESS</td>\n                            <td><a href=https://www.openlibing.com/apps/entryCheckDashCode/MR_fd90c6a6a3514a21989012573c42d04a/c058c1a96979f66469fe1ec06d232515?projectId=300033&co