+"""CPU-only offline comparison, including parity with TTK when installed."""
+
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+os.environ["TORCH_DEVICE_BACKEND_AUTOLOAD"] = "0"
+
+import pytest
+import torch
+
+SCRIPT = Path(__file__).with_name("assets") / "offline_compare.py"
+module_spec = importlib.util.spec_from_file_location("fa_offline_test", SCRIPT)
+offline = importlib.util.module_from_spec(module_spec)
+module_spec.loader.exec_module(offline)
+
+
+def make_inputs(dtype=torch.float16, mask=0, sinks=False):
+    gen = torch.Generator().manual_seed(46)
+    return {
+        "q": torch.randn(1, 3, 4, 16, dtype=dtype, generator=gen),
+        "k": torch.randn(1, 5, 2, 16, dtype=dtype, generator=gen),
+        "v": torch.randn(1, 5, 2, 8, dtype=dtype, generator=gen),
+        "sinks": torch.tensor([0.1, 0.2, 0.3, 0.4]) if sinks else None,
+        "attributes": {
+            "softmax_scale": 0.25,
+            "mask_mode": mask,
+            "win_left": 1 if mask == 4 else -1,
+            "win_right": 0 if mask == 4 else -1,
+            "return_softmax_lse": True,
+        },
+    }
+
+
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16])
+@pytest.mark.parametrize("mask", [0, 3, 4])
+@pytest.mark.parametrize("sinks", [False, True])
+def test_cpu_fp32_mask_and_sink_against_dense_formula(dtype, mask, sinks):
+    a = make_inputs(dtype, mask, sinks)
+    result, settings = offline.cpu_golden(a)
+    q = a["q"].float().transpose(1, 2)
+    k = a["k"].float().repeat_interleave(2, dim=2).transpose(1, 2)
+    v = a["v"].float().repeat_interleave(2, dim=2).transpose(1, 2)
+    scores = (q @ k.transpose(-2, -1)) * 0.25
+    rows = torch.arange(3)[:, None] + 2
+    columns = torch.arange(5)[None, :]
+    if mask == 3:
+        scores.masked_fill_(columns > rows, -torch.inf)
+    elif mask == 4:
+        scores.masked_fill_((columns > rows) | (columns < rows - 1), -torch.inf)
+    if sinks:
+        scores = torch.cat(
+            (scores, a["sinks"][None, :, None, None].expand(1, -1, 3, 1)), -1
+        )
+        v = torch.cat((v, torch.zeros(1, 4, 1, 8)), 2)
+    expected = (scores.softmax(-1) @ v).transpose(1, 2)
+    torch.testing.assert_close(result["attn_out"], expected)
+    torch.testing.assert_close(result["softmax_lse"], scores.logsumexp(-1))
+    assert all(t.dtype == torch.float32 for t in result.values())
+    assert settings["mask_mode"] == mask
+
+
+def test_layouts_and_positional_inputs():
+    a = make_inputs()
+    expected, _ = offline.cpu_golden(a)
+    bnsd = {name: a[name].transpose(1, 2).contiguous() for name in ("q", "k", "v")}
+    actual, _ = offline.cpu_golden(
+        bnsd,
+        dict(a["attributes"], layout_q="BNSD", layout_kv="BNSD", layout_out="BSND"),
+    )
+    torch.testing.assert_close(actual["attn_out"], expected["attn_out"])
+    actual, _ = offline.cpu_golden([a["q"], a["k"], a["v"]], a["attributes"])
+    torch.testing.assert_close(actual["softmax_lse"], expected["softmax_lse"])
+    tnd = {name: a[name].flatten(0, 1) for name in ("q", "k", "v")}
+    tnd.update(
+        cu_seqlens_q=torch.tensor([0, 3], dtype=torch.int32),
+        cu_seqlens_kv=torch.tensor([0, 5], dtype=torch.int32),
+    )
+    actual, _ = offline.cpu_golden(
+        tnd, dict(a["attributes"], layout_q="TND", layout_kv="TND", layout_out="TND")
+    )
+    torch.testing.assert_close(actual["attn_out"], expected["attn_out"].flatten(0, 1))
+
+
+def test_paged_inputs_rejected():
+    a = make_inputs()
+    with pytest.raises(ValueError, match="non-paged"):
+        offline.cpu_golden(a, {"layout_kv": "PA_BBND"})
+
+
+@pytest.mark.parametrize("dtype", ["float16", "bfloat16", "float32"])
+@pytest.mark.parametrize("level", ["L0", "L1", "L2"])
+@pytest.mark.parametrize("case", ["ordinary", "zeros", "special", "small"])
+def test_matches_real_ttk(dtype, level, case):
+    resolve = pytest.importorskip("ttk.core_modules.common.comparison.resolve")
+    comparison = pytest.importorskip("ttk.core_modules.common.comparison.cross_check")
+    c = torch.tensor([1.0, 0.5, -2.0, 3.0, 0.0, 1e-10])
+    a = c + torch.tensor([0.01, 0.002, -0.03, 0.0, 1e-5, 1e-7])
+    b = c + torch.tensor([0.002, 0.001, -0.02, 0.0, 0.0, 1e-7])
+    if case == "zeros":
+        a = b = c = torch.ones(6)
+    elif case == "special":
+        a = torch.tensor([float("nan"), float("inf"), -float("inf"), 1016.0, 0.0, 1.0])
+        b = torch.tensor(
+            [float("nan"), float("inf"), -float("inf"), float("inf"), 0.0, 1.0]
+        )
+        c = torch.tensor(
+            [float("nan"), float("inf"), -float("inf"), 1016.26996, 0.0, 1.0]
+        )
+    elif case == "small":
+        a = torch.full((6,), 0.01)
+        b = c = torch.zeros(6)
+    a, b = (t.to(getattr(torch, dtype)) for t in (a, b))
+    actual = offline.compare(a, b, c, level, dtype)
+    params = resolve.resolve_tolerance(
+        {dtype: {"standard": "cross_check", "level": level}},
+        None,
+        None,
+        [dtype],
+        "cross_check",
+    )[0].params
+    arrays = [offline.array(t) for t in (a, c, b)]
+    _, _, passed, metrics = comparison.CrossCheckComparison(
+        arrays[0], arrays[1], 0, dtype, params, third_party=arrays[2]
+    ).compare()
+    assert actual["pass"] == passed
+    for name in ("mare", "mere", "rmse"):
+        expected = metrics["result"][name]
+        if expected is not None:
+            assert actual["ratios"][name] == pytest.approx(
+                expected, rel=1e-12, abs=1e-15
+            )
+    assert actual["small_errors"]["ratio"] == metrics["result"]["small_err_ratio"]
+
+
+def test_raw_values_explain_one():
+    c = torch.ones(4)
+    a = c + 0.01
+    result = offline.compare(a, a, c)
+    assert result["ratios"]["mare"] == 1.0
+    assert result["raw"]["npu"]["mare"] == result["raw"]["gpu"]["mare"] > 0
+    exact = offline.compare(c, c, c)
+    assert exact["ratios"]["mare"] == 1.0
+    assert exact["ratio_cases"]["mare"] == "both_zero"
+    assert exact["raw"]["npu"]["mare"] == 0
+
+
+def test_suppression_and_shape_validation():
+    a = make_inputs()
+    result, _ = offline.cpu_golden(a, {"return_softmax_lse": False})
+    assert result["softmax_lse"] is None
+    with pytest.raises(ValueError, match="Shape mismatch"):
+        offline.compare(torch.ones(2, 2), torch.ones(4), torch.ones(2, 2))
+
+
+def test_output_containers_and_selectors():
+    a, b = torch.ones(2), torch.zeros(1)
+    assert set(offline.outputs({"outputs": (a, b), "inputs": {"q": a}})) == {
+        "attn_out",
+        "softmax_lse",
+    }
+    assert set(offline.outputs({"output": a, "lse": b})) == {"attn_out", "softmax_lse"}
+    assert set(
+        offline.outputs({"nested": {"lse": b}}, "nested.lse", "softmax_lse")
+    ) == {"softmax_lse"}
+    with pytest.raises(ValueError, match="Cannot locate outputs"):
+        offline.outputs({"q": a, "k": a, "v": a})
+
