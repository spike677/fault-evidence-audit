向的分段数量\n-    // CoutSegmentCount = ceil(Cout / CoutThreshold)\n+    // CoutSegmentCount: Cout方向的分段数量 -> CoutSegmentCount = ceil(Cout / CoutThreshold)\n     uint32_t coutSegmentCount =\n         std::max(Ops::Base::CeilDiv(static_cast<uint32_t>(runInfo_.dedy_cout_g), coutThreshold), ONE_U32);\n \n","old_path":"conv/conv3d_backprop_input_v2/op_host/op_tiling/arch35/conv3d_backprop_input_v2_inner_product_tiling.cpp","new_path":"conv/conv3d_backprop_input_v2/op_host/op_tiling/arch35/conv3d_backprop_input_v2_inner_product_tiling.cpp","a_mode":"100644","b_mode":"100644","new_file":false,"renamed_file":false,"deleted_file":false,"too_large":false,"added_lines":6,"removed_lines":4},"target_branch":"master","source_branch":"fix-zzj-precision-error","source_project":{"id":7858845,"full_name":"linruihan/ops-nn","human_name":"linruihan / ops-nn","path":"ops-nn"},"target_project":{"id":7665709,"full_name":"cann/ops-nn","human_name":"CANN / ops-nn","path":"ops-nn"}},{"sha":"e5ff117479698b493a4ee58d464fa54fc8998468","filename":"conv/conv3d_backprop_input_v2/op_host/op_tiling/arch35/conv3d_backprop_input_v2_inner_product_tiling.h","additions":1,"deletions":0,"blob_id":"e22ca63f4985043b19084b3de9d7d43cd9100c74","blob_url":"https://gitcode.com/cann/ops-nn/blob/e5ff117479698b493a4ee58d464fa54fc8998468/conv/conv3d_backprop_input_v2/op_host/op_tiling/arch35/conv3d_backprop_input_v2_inner_product_tiling.h","raw_url":"https://raw.gitcode.com/cann/ops-nn/raw/e5ff117479698b493a4ee58d464fa54fc8998468/conv/conv3d_backprop_input_v2/op_host/op_tiling/arch35/conv3d_backprop_input_v2_inner_product_tiling.h","patch":{"diff":"@@ -31,6 +31,7 @@ constexpr uint32_t NUM_FIVE = 5;\n constexpr uint32_t MAX_K_VALUE_SPLIT_K = 32768;\n // 暂定切HkWk准入为8192\n constexpr uint32_t MAX_K_VALUE_TILING_KERNEL = 8192;\n+constexpr uint32_t MAX_K_VALUE_FP32_DN = 2048;\n \n class Conv3DDXV2InnerProductTiling : public Conv3DBackpropInputV2TilingArch35 {\n public:\n","old_path":"conv/conv3d_backprop_input_v2/op_host/op_til