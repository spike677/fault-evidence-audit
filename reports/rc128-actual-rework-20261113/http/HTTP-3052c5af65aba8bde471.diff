+"""FA3 CUDA third-party adapter, including layouts, paging and sinks."""
+
+import torch
+
+
+def _int_vector(tensor, name, count=None):
+    if tensor is None or tensor.dtype != torch.int32 or tensor.ndim != 1:
+        raise ValueError(f"{name} must be a one-dimensional int32 tensor")
+    values = tensor.detach().cpu().tolist()
+    if count is not None and len(values) != count:
+        raise ValueError(f"{name} must contain {count} elements")
+    return values
+
+
+def _sequence_lengths(cumulative, total, name):
+    values = _int_vector(cumulative, name)
+    if len(values) < 2 or values[0] != 0 or values[-1] != total:
+        raise ValueError(f"{name} must cover the TND tensor from 0")
+    lengths = [end - start for start, end in zip(values, values[1:])]
+    if min(lengths) < 0:
+        raise ValueError(f"{name} must be nondecreasing")
+    return lengths
+
+
+def _kv_geometry(k, v, layout):
+    rank = 5 if layout == "PA_NZ" else 3 if layout == "TND" else 4
+    if any(t.ndim != rank or min(t.shape) <= 0 for t in (k, v)):
+        raise ValueError(f"K/V require nonempty rank-{rank} tensors for {layout}")
+    if layout == "PA_NZ":
+        if k.shape[-1] != 16 or v.shape[-1] != 16:
+            raise ValueError("PA_NZ requires D0=16")
+        if (k.shape[0], k.shape[1], k.shape[3]) != (v.shape[0], v.shape[1], v.shape[3]):
+            raise ValueError("paged K/V cache geometry must match")
+        return k.shape[1], k.shape[2] * 16, v.shape[2] * 16, k.shape[3]
+    if k.shape[:-1] != v.shape[:-1]:
+        raise ValueError("K/V geometry must match except for head dimension")
+    head_axis = 1 if layout in ("TND", "BNSD", "PA_BNBD") else 2
+    seq_axis = 2 if layout in ("BNSD", "PA_BNBD") else 1
+    return k.shape[head_axis], k.shape[-1], v.shape[-1], k.shape[seq_axis]
+
+
+def _validate_fa3(arguments):
+    q, k, v = (arguments[name] for name in ("q", "k", "v"))
+    lq, lk, lo = (arguments[name] for name in ("layout_q", "layout_kv", "layout_out"))
+    allowed = {
+        "TND": (("TND", "PA_BBND", "PA_BNBD", "PA_NZ"), ("TND",)),
+        "BSND": (("BSND", "PA_BBND", "PA_BNBD", "PA_NZ"), ("BSND",)),
+        "BNSD": (("BNSD", "PA_BBND", "PA_BNBD", "PA_NZ"), ("BNSD", "BSND")),
+    }
+    if lq not in allowed or lk not in allowed[lq][0] or lo not in allowed[lq][1]:
+        raise ValueError(f"unsupported layouts: {lq}, {lk}, {lo}")
+    if q.ndim != (3 if lq == "TND" else 4) or min(q.shape) <= 0:
+        raise ValueError("Q must have a nonempty shape matching its layout")
+    if (
+        q.dtype not in (torch.float16, torch.bfloat16)
+        or k.dtype != q.dtype
+        or v.dtype != q.dtype
+    ):
+        raise ValueError("FA3 Q/K/V must have the same float16 or bfloat16 dtype")
+    nq = q.shape[1 if lq in ("TND", "BNSD") else 2]
+    nk, dk, dv, block_size = _kv_geometry(k, v, lk)
+    # Adapter capability is deliberately broader than today's NPU checker.
+    if dk != q.shape[-1] or not (1 <= dk <= 256 and 1 <= dv <= 256):
+        raise ValueError("Q/K dimensions must match and D/DV must be in [1, 256]")
+    if nq % nk:
+        raise ValueError("Q heads must be divisible by KV heads")
+    paged = lk.startswith("PA_")
+    for tensor in (k, v):
+        if any(s <= 0 for s in tensor.stride()):
+            raise ValueError("K/V strides must be positive")
+        if not paged and not tensor.is_contiguous():
+            raise ValueError("non-paged K/V must be contiguous")
+        if paged:
+            inner = 1
+            first_inner = 1 if lk == "PA_BBND" else 2
+            for dim in range(tensor.ndim - 1, first_inner - 1, -1):
