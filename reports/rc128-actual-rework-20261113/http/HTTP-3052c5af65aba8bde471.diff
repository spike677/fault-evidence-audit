+
+"""Integration contracts between the L2 NPU and native TTK FA3 routes."""
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+import torch
+
+
+ASSETS = Path(__file__).with_name("assets")
+module_spec = importlib.util.spec_from_file_location(
+    "fa3_selection_spec", ASSETS / "spec.py"
+)
+spec = importlib.util.module_from_spec(module_spec)
+module_spec.loader.exec_module(spec)
+policy = spec._load("cross_check")
+
+
+def inputs():
+    return dict(
+        q=torch.randn(1, 3, 2, 16, dtype=torch.float16),
+        k=torch.randn(1, 5, 1, 16, dtype=torch.float16),
+        v=torch.randn(1, 5, 1, 8, dtype=torch.float16),
+        return_softmax_lse=True,
+    )
+
+
+@pytest.mark.parametrize("enabled", [False, True])
+def test_explicit_npu_hook(monkeypatch, enabled):
+    monkeypatch.setenv("FLASH_ATTN_CROSS_CHECK_BACKEND", "npu")
+    monkeypatch.setattr(policy, "enabled", lambda: enabled)
+    assert policy.backend() == "npu"
+    expected = policy.compare if enabled else None
+    assert spec.FlashAttnSpec.compare is expected
+
+
+@pytest.mark.parametrize("selection", [None, "fa3"])
+def test_native_fa3_has_no_npu_compare_hook(monkeypatch, selection):
+    if selection is None:
+        monkeypatch.delenv("FLASH_ATTN_CROSS_CHECK_BACKEND", raising=False)
+    else:
+        monkeypatch.setenv("FLASH_ATTN_CROSS_CHECK_BACKEND", selection)
+    assert policy.backend() == "fa3"
+
+    def never_read_ttk_switches():
+        raise AssertionError("FA3 route must not select the local compare hook")
+
+    monkeypatch.setattr(policy, "enabled", never_read_ttk_switches)
+    assert spec.FlashAttnSpec.compare is None
+    assert spec.FlashAttnSpec.third_party["torch"] is spec._load("fa3").FA3ThirdParty
+
+
+def test_invalid_backend_fails(monkeypatch):
+    monkeypatch.setenv("FLASH_ATTN_CROSS_CHECK_BACKEND", "typo")
+    with pytest.raises(ValueError, match="must be npu or fa3"):
+        _ = spec.FlashAttnSpec.compare
+
+
+@pytest.mark.parametrize("reference_mode", ["fp32", "mixed", "fp64"])
+def test_npu_cross_check_keeps_fp64(monkeypatch, reference_mode):
+    monkeypatch.setenv("FLASH_ATTN_CROSS_CHECK_BACKEND", "npu")
+    monkeypatch.setattr(policy, "enabled", lambda: True)
+    actual = spec.FlashAttnSpec.golden(**inputs(), reference_mode=reference_mode)
+    assert all(value.dtype == torch.float64 for value in actual)
+
+
+@pytest.mark.parametrize("enabled", [False, True])
+@pytest.mark.parametrize(
+    "mode,dtype",
+    [
+        ("fp32", torch.float32),
+        ("mixed", torch.float16),
+        ("fp64", torch.float64),
+    ],
+)
+def test_fa3_respects_explicit_reference_mode(monkeypatch, enabled, mode, dtype):
+    monkeypatch.setenv("FLASH_ATTN_CROSS_CHECK_BACKEND", "fa3")
+    monkeypatch.setattr(policy, "enabled", lambda: enabled)
+    actual = spec.FlashAttnSpec.golden(**inputs(), reference_mode=mode)
+    assert actual[0].dtype == dtype
+    assert actual[1].dtype == (torch.float64 if mode == "fp64" else torch.float32)
+
+
+def test_non_cross_check_reference_modes(monkeypatch):
+    monkeypatch.setenv("FLASH_ATTN_CROSS_CHECK_BACKEND", "npu")
+    monkeypatch.setattr(policy, "enabled", lambda: False)
+    a = inputs()
+    assert spec.FlashAttnSpec.golden(**a)[0].dtype == torch.float32
+    assert (
+        spec.FlashAttnSpec.golden(**a, reference_mode="mixed")[0].dtype == torch.float16
+    )
+    assert (
+        spec.FlashAttnSpec.golden(**a, reference_mode="fp64")[0].dtype == torch.float64
+    )
+
+
+@pytest.mark.parametrize("dtype", ["float16", "bfloat16", "float32"])
+def test_native_and_local_share_l2(dtype):
+    resolve = pytest.importorskip("ttk.core_modules.common.comparison.resolve")
+    native = resolve.resolve_tolerance(
+        spec.FlashAttnSpec.tolerance, None, None, [dtype], "cross_check"
+    )[0].params
+    local = resolve.resolve_tolerance(
+        policy.TOLERANCE, None, None, [dtype], "cross_check"
+    )[0].params
+    assert native == local
+    assert (native["mare_ratio"], native["mere_ratio"], native["rmse_ratio"]) == (
+        2,
+        1.2,
+        1.2,
+    )
+
+
+@pytest.mark.parametrize("enabled", [False, True])
