diff --git a/math/bitwise_and/op_graph/bitwise_and_graph_infer.cpp b/math/bitwise_and/op_graph/bitwise_and_graph_infer.cpp
index af3ad6c98ba56f006662bf41dfdb975973791ea7..fb7a69f00516231d788caef0d15b432b7859ccec 100644
--- a/math/bitwise_and/op_graph/bitwise_and_graph_infer.cpp
+++ b/math/bitwise_and/op_graph/bitwise_and_graph_infer.cpp
@@ -10,8 +10,34 @@
 
 #include "register/op_impl_registry.h"
 #include "op_graph/graph_infer_comm_funcs.h"
+#include "log/log.h"
 
 using namespace ge;
 namespace ops {
-IMPL_OP(BitwiseAnd).InferDataType(InferDataTypeOutputSameAsInput);
+static bool IsSupportedIntegerDtype(const ge::DataType dtype)
+{
+    return dtype == ge::DT_INT8 || dtype == ge::DT_INT16 || dtype == ge::DT_INT32 || dtype == ge::DT_INT64 ||
+           dtype == ge::DT_UINT8 || dtype == ge::DT_UINT16 || dtype == ge::DT_UINT32 || dtype == ge::DT_UINT64;
+}
+
+static ge::graphStatus InferDataType4BitwiseAnd(gert::InferDataTypeContext* context)
+{
+    OP_LOGD(context->GetNodeName(), "Begin to do InferDataType4BitwiseAnd");
+
+    const ge::DataType x1DataType = context->GetInputDataType(0);
+    const ge::DataType x2DataType = context->GetInputDataType(1);
+    OP_CHECK_IF(!IsSupportedIntegerDtype(x1DataType),
+                OP_LOGE_FOR_INVALID_DTYPE(context->GetNodeName(), "x1", Ops::Base::ToString(x1DataType).c_str(),
+                                          "int8, int16, int32, int64, uint8, uint16, uint32 or uint64"),
+                return ge::GRAPH_FAILED);
+    OP_CHECK_IF(x1DataType != x2DataType,
+                OP_LOGE_FOR_INVALID_DTYPES_WITH_REASON(
+                    "BitwiseAnd", "x1 and x2",
+                    (Ops::Base::ToString(x1DataType) + " and " + Ops::Base::ToString(x2DataType)).c_str(),
+                    "x1 and x2 must have the same dtype"),
+                return ge::GRAPH_FAILED);
+    return context->SetOutputDataType(0, x1DataType);
+}
+
+IMPL_OP(BitwiseAnd).InferDataType(InferDataType4BitwiseAnd);
 } // namespace ops
