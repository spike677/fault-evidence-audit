+def run_cli(*args):
+    # Verify that even importing any accelerator/framework package is forbidden.
+    bootstrap = """
+import importlib.abc, runpy, sys
+class BlockDevicePackages(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname.split('.')[0] in ('torch_npu', 'cann_ops_transformer', 'ttk', 'flash_attn_interface'):
+            raise AssertionError('Unexpected package: '+fullname)
+sys.meta_path.insert(0, BlockDevicePackages())
+sys.argv = sys.argv[1:]
+runpy.run_path(sys.argv[0], run_name='__main__')
+"""
+    return subprocess.run(
+        [sys.executable, "-c", bootstrap, str(SCRIPT), *map(str, args)],
+        capture_output=True,
+        text=True,
+    )
+
+
+def test_cli_complete_input_bundle_and_golden_replay(tmp_path):
+    a = make_inputs(mask=4, sinks=True)
+    golden, _ = offline.cpu_golden(a)
+    saved_outputs = (golden["attn_out"].half(), golden["softmax_lse"])
+    torch.save({"inputs": a}, tmp_path / "inputs.pt")
+    torch.save({"inputs": a, "outputs": saved_outputs}, tmp_path / "npu.pt")
+    torch.save(
+        {"result": {"out": saved_outputs[0], "lse": saved_outputs[1]}},
+        tmp_path / "gpu.pt",
+    )
+    result = run_cli(
+        "--inputs",
+        tmp_path / "inputs.pt",
+        "--npu",
+        tmp_path / "npu.pt",
+        "--gpu",
+        tmp_path / "gpu.pt",
+        "--report",
+        tmp_path / "report.json",
+        "--save-golden",
+        tmp_path / "golden.pt",
+    )
+    assert result.returncode == 0, result.stderr
+    report = json.loads((tmp_path / "report.json").read_text())
+    assert report["pass"] and report["level"] == "L2"
+    assert report["outputs"]["attn_out"]["input_dtypes"]["golden"] == "torch.float32"
+    assert "NPU vs CPU raw" in result.stdout
+    result = run_cli(
+        "--golden",
+        tmp_path / "golden.pt",
+        "--npu",
+        tmp_path / "npu.pt",
+        "--gpu",
+        tmp_path / "gpu.pt",
+    )
+    assert result.returncode == 0, result.stderr
+    result = run_cli("--inspect", tmp_path / "inputs.pt")
+    assert result.returncode == 0 and "root.inputs.q:" in result.stdout
+
+
+def test_cli_fail_and_missing_golden(tmp_path):
+    torch.save(torch.ones(4), tmp_path / "gpu.pt")
+    torch.save(torch.ones(4), tmp_path / "golden.pt")
+    torch.save(torch.ones(4) + 0.5, tmp_path / "npu.pt")
+    result = run_cli(
+        "--npu",
+        tmp_path / "npu.pt",
+        "--gpu",
+        tmp_path / "gpu.pt",
+        "--golden",
+        tmp_path / "golden.pt",
+    )
+    assert result.returncode == 1 and "FAIL" in result.stdout
+    result = run_cli("--npu", tmp_path / "npu.pt", "--gpu", tmp_path / "gpu.pt")
+    assert result.returncode == 2 and "three-way" in result.stderr
