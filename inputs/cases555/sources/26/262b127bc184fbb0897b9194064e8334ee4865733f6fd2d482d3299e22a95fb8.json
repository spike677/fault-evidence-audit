040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":163071557,"discussion_id":"37f4dce98e5aeabe83f322698e01178d7a7c2dac","body":"### CLA Signature Pass  \n wuyi_huawei, thanks for your pull request. All authors of the commits have signed the CLA. :+1: ","created_at":"2026-02-12T17:42:59+08:00","updated_at":"2026-02-12T17:42:59+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":163071628,"discussion_id":"03befb5286e416d86bd81834845af2126f87fd00","body":"compile","created_at":"2026-02-12T17:43:19+08:00","updated_at":"2026-02-12T17:43:19+08:00","user":{"id":"6822c17d24adff5452d7b741","login":"wuyi_huawei","object_id":"6822c17d24adff5452d7b741","name":"wuyi_51","html_url":"https://gitcode.com/wuyi_huawei"},"comment_type":"pr_comment"},{"id":163071720,"discussion_id":"bdf1517368f6a22ffbeb73a7222630479857bf27","body":"## 问题/功能描述\n\n本PR主要包含两项修改：1）修复在特定复杂切分场景下（使用低阶API、A矩阵全载、多轮计算且M方向分块数大于1）进行尾块切分时，因当前块调度逻辑导致的精度问题，确保模型推理结果的准确性。2）为量化批量矩阵乘法（QuantBatchMatmulV3）算子新增一个针对Ascend950平台的特定测试用例，用于验证在MXFP8量化模式下，启用A矩阵全加载和尾部切分优化策略时的算子切分逻辑正确性，以扩展测试覆盖范围。\n\n## 修改方案描述\n\n第一项修改在自适应滑动窗口切分算法的尾块计算逻辑中，针对A矩阵全载模式增加了一个约束条件：当总块数超过AI Core数量且M方向分块数不为1时，强制将N方向的尾块切分数设置为1，从而禁用尾块切分，以规避调度策略引发的精度问题。第二项修改是在测试数据文件 `test_quant_batch_matmul_v3.csv` 中新增一行测试记录，定义了特定的输入维度、量化模式、数据类型及tiling参数，以构造一个具体的测试场景来验证相关优化策略。两项修改均不涉及对外接口或安全敏感操作的变更。","created_at":"2026-02-12T17:43:58+08:00","updated_at":"2026-02-12T17:43:58+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1e