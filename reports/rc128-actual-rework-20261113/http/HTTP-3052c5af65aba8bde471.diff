+    monkeypatch.setitem(
+        sys.modules,
+        "flash_attn_interface",
+        SimpleNamespace(flash_attn_varlen_func=packed_fp64_fa3),
+    )
+    actual = cross._fa3_attention(a, *cross._validate_fa3(a))
+    assert actual[0].dtype == a["q"].dtype
+    torch.testing.assert_close(actual[0].float(), expected[0], rtol=0.01, atol=0.004)
+    if expected[1] is None:
+        torch.testing.assert_close(actual[1], torch.zeros(1, dtype=torch.float32))
+    else:
+        assert actual[1].dtype == torch.float32
+        torch.testing.assert_close(actual[1], expected[1], rtol=2e-6, atol=2e-6)
+    for name, original in before.items():
+        torch.testing.assert_close(original, a[name], rtol=0, atol=0)
+
