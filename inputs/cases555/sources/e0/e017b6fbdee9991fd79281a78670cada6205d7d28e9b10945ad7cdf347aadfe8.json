d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":162926291,"discussion_id":"4c6cc355c4cf80c64727eac925d63f4c64b2c942","body":"## 问题/功能描述\n\n修复了 `repeat_interleave` 算子内核实现中，内部状态计数器 `copyFromXNum_` 更新位置错误的问题。该问题发生在循环处理特定数据块时，可能导致状态跟踪不准确，进而影响数据复制的正确性或性能。\n\n## 修改方案描述\n\n将 `copyFromXNum_` 计数器的更新逻辑从 `CopyOneCpToRepeatOut` 函数内部，移至其调用者 `CopyXToMatchOut` 函数内的循环末尾。这一调整确保了计数器仅在完成对一个完整数据块（大小为 `tilingData_.mergedDims[2]`）的所有重复复制操作后才递增，使状态管理与实际数据处理流程保持一致，从而保证了算法的正确性。","created_at":"2026-02-11T16:12:00+08:00","updated_at":"2026-02-11T16:12:00+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":163026746,"discussion_id":"a76738736f078b40faced6d4ef9074b238c090c9","body":":large_blue_circle: source code change are detected, tasks labels is removed in this pull request!","created_at":"2026-02-12T14:11:27+08:00","updated_at":"2026-02-12T14:11:27+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":163098794,"discussion_id":"64d6a74f7741372a9a087be5a5088d6793035cd3","body":":large_blue_circle: source code change are detected, tasks labels is removed in this pull request!","created_at":"2026-02-12T21:11:18+08:00","updated_at":"2026-02-12T21:11:18+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.