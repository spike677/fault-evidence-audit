0d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":179481359,"discussion_id":"7a9f4988a81fc4bd76af793df803d9cca1695f29","body":"/check-pr","created_at":"2026-07-10T16:08:15+08:00","updated_at":"2026-07-10T16:08:15+08:00","user":{"id":"66790bc427e48875c207f499","login":"liaohuming","object_id":"66790bc427e48875c207f499","name":"liaohuming","avatar_url":"https://cdn-img.gitcode.com/fd/ab/4fd6a980b0a3622d464a6d25307a92a65e66a3337cf58d7209006fbc1fa8cde1.jpg","html_url":"https://gitcode.com/liaohuming"},"comment_type":"pr_comment"},{"id":179481382,"discussion_id":"1314a455e81d1457c98109eb2b7b1101476f6f60","body":"**The following labels are not ready**.\n\nlgtm: Please wait for reviewers to review the code.\n\napproved: Please wait for committers to review the code.\n\n","created_at":"2026-07-10T16:08:19+08:00","updated_at":"2026-07-10T16:08:19+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":179481861,"discussion_id":"82282213e77fed4f0fcf7db6efa320e2e2176e9d","body":"\uD83D\uDFE0 **High Priority**\n\n与 `cut_gh.h` 中的问题相同。`ProcessSplitH` 函数（第 394-396 行 main loop、第 415-417 行 tail block）已增加了 `SetFlag/WaitFlag<HardEvent::MTE3_V>` 同步。但 `BinaryReduceSum` 函数（第 436-474 行）中相同 `CopyDataIn → ReduceSum` 模式未加入同步：\n\n当 `T == float` 时，`CopyDataIn` 内部无 MTE→V 同步（与 cut_gh.h 的 CopyDataIn 实现相同）。`BinaryReduceSum` 在此情况下会因数据竞争产生间歇性错误累加结果。\n\n触发路径：`ProcessSplitG` → `SetGParam` → `BinaryReduceSum`，当 `g_ * BLOCK_SIZE * sizeof(PromoteDataT) > usedUbSize_` 时触发。\n\n```suggestion\n在 BinaryReduceSum 中每次 CopyDataIn 调用后、ReduceSum 调用前，添加 MTE3_V 同步：\n\n在第 442 行（CopyDataIn 之后、srcShape 定义之前）和第 451 行（CopyDataIn 之后、srcShape[0] 赋值之前）以及第 465 行（CopyDataIn 之后、srcShape 定义之前）各插入以下三行：\nevent_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));\nSetFlag<HardEvent::MTE3_V>(eventId);\nWaitFlag<HardEvent::MTE3_V>(eventId);\n```\n","created_at":"2026-07-10T16:09:54+08:00","updated_at":"2026-07-10T16:10:14+08:00","user":{"id":"672dd45c4ea6673461aa2102","login":"atomgit-bot","object_id":"672dd45c4ea6673461aa2102","name":"atomgit-bot","avatar_url":"https://cdn-img.gitcode.com/fb/bb/88f9bbb284ce2dc057d85551b1bbe66acb35305ce59007d28029609b5e4b9652.png?time=1777513981052","html_url":"https://gitcode.com/atomgit-bot"},"comment_type":"diff_comment","resolved":true,"resolved_by":{"id":"66790bc427e48875c207f499","login":"liaohuming","object_id":"66790bc427e48875c207f499","name":"liaohuming","avatar_url":"https://cdn-img.gitcode.com/fd/ab/4fd6a980b0a3622d464a6d25307a92a65e66a3337cf58d7209006fbc1fa8cde1.jpg","html_url":"https://gitcode.com/liaohuming"},"diff_position":{"start_new_line":467,"end_new_line":467,"start_old_line":452,"end_old_line":452,"position_type":"text"}},{"id":179481868,"discussion_id":"39c61f26986fa23fd40f5b0ed48390574bf1f0dd","body":"\uD83D\uDFE0 **High Priority**\n\n本 PR 在 `ProcessMultiHBlock`（第 357-359 行）和 `ProcessSingleHBlock`（第 381-383 行）中增加了 `SetFlag/WaitFlag<HardEvent::MTE3_V>` 同步，以修复 \"tongbu bug\"——`CopyDataIn` 通过 MTE3 异步搬运数据后，紧接着 V 引擎的 `ReduceSum` 可能在搬运完成前就读取数据，导致结果错误。\n\n但 `BinaryReduceSum` 函数（第 404-444 行）中存在完全相同的 `CopyDataIn → ReduceSum` 调用模式，却没有加入 MTE3_V 同步：\n\n特别地，当 `T == float`（`IsSameType<PromoteDataT, T>::value` 为 true）时，`CopyDataIn` 内部走第 566-568 行的分支，没有任何 MTE→V 同步——`DataCopyPad` 异步搬运后直接 `xQue_.EnQue`，依赖 `TQue::DeQue` 本身并不保证 MTE3 搬运已完成。`BinaryReduceSum` 分支在 float 输入下同样会触发数据竞争，导致累加结果间歇性错误。\n\n触发条件：`Process()` 中 `currBlockSize * sizeof(PromoteDataT) > inUbSize_`（数据超出一块 UB 容量），走二分累加路径。该路径在大模型场景下频繁命中。\n\n```suggestion\n在 BinaryReduceSum 中每次 CopyDataIn 调用后、ReduceSum 调用前，添加与 ProcessMultiHBlock/ProcessSingleHBlock 相同的 MTE3_V 同步：\n\n在第 411 行（CopyDataIn 之后、srcShape 定义之前）和第 420 行（CopyDataIn 之后、srcShape[0] 赋值之前）以及第 436 行（CopyDataIn 之后、srcShape 定义之前）各插入以下三行：\nevent_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));\nSetFlag<HardEvent::MTE3_V>(eventId);\nWaitFlag<HardEvent::MTE3_V>(eventId);\n```\n","created_at":"2026-07-10T16:09:56+08:00","updated_at":"2026-07-10T16:10:17+08:00","user":{"id":"672dd45c4ea6673461aa2102","login":"atomgit-bot","object_id":"672dd45c4ea6673461aa2102","name":"atomgit-bot","avatar_url":"https://cdn-img.gitcode.com/fb/bb/88f9bbb284ce2dc057d85551b1bbe66acb35305ce59007d28029609b5e4b9652.png?time=1777513981052","html_url":"https://gitcode.com/atomgit-bot"},"comment_type":"diff_comment","resolved":true,"resolved_by":{"id":"66790bc427e48875c207f499","login":"liaohuming","object_id":"66790bc427e48875c207f499","name":"liaohuming","avatar_url":"https://cdn-img.gitcode.com/fd/ab/4fd6a980b0a3622d464a6d25307a92a65e66a3337cf58d7209006fbc1fa8cde1.jpg","html_url":"https://gitcode.com/liaohuming"},"diff_position":{"start_new_line":438,"end_new_line":438,"start_old_line":410,"end_old_line":410,"position_type":"text"}},{"id":179596315,"discussion_id":"20d9ca2b058bb3b7fb13779c6538c6cd0c286ced","body":"/check-pr","created_at":"2026-07-11T14:21:18+08:00","updated_at":"2026-07-11T14:21:18+08:00","user":{"id":"66790bc427e48875c207f499","login":"liaohuming","object_id":"66790bc427e48875c207f499","name":"liaohuming","avatar_url":"https://cdn-img.gitcode.com/fd/ab/4fd6a980b0a3622d464a6d25307a92a65e66a3337cf58d7209006fbc1fa8cde1.jpg","html_url":"https://gitcode.com/liaohuming"},"comment_type":"pr_comment"},{"id":179596319,"discussion_id":"11d999c3ce8caba55b81f15affe2f6b8cdf71264","body":"**The following labels are not ready**.\n\nlgtm: Please wait for reviewers to review the code.\n\napproved: Please wait for committers to review the code.\n\n","created_at":"2026-07-11T14:21:22+08:00","updated_at":"2026-07-11T14:21:22+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-r