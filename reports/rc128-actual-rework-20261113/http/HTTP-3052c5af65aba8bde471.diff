@@ -0,0 +1,446 @@
+# -----------------------------------------------------------------------------------------------------------
+# Copyright (c) 2026 Huawei Technologies Co., Ltd.
+# This program is free software, you can redistribute it and/or modify it under the terms and conditions of
+# CANN Open Software License Agreement Version 2.0 (the "License").
+# Please refer to the License for details. You may not use this file except in compliance with the License.
+# THIS SOFTWARE IS PROVIDED ON AN "AS IS" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,
+# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
+# See LICENSE in the root of the software repository for the full text of the License.
+# -----------------------------------------------------------------------------------------------------------
+
+"""CPU-only comparison of saved FlashAttn outputs against an FP32 golden.
+
+Run from this file's assets directory, or keep the sibling impl/ directory.
+No TTK, CANN, torch_npu, FA3 installation or accelerator execution is needed.
+"""
+
+import argparse
+import importlib.util
+import inspect
+import json
+import math
+import os
+from pathlib import Path
+import sys
+
+os.environ["TORCH_DEVICE_BACKEND_AUTOLOAD"] = "0"
+
+import numpy as np
+import torch
+
+
+LEVELS = {"L0": (10.0, 2.0, 2.0), "L1": (5.0, 1.5, 1.5), "L2": (2.0, 1.2, 1.2)}
+SMALL = {
+    "float16": (2**-11, 2**-16),
+    "bfloat16": (2**-8, 2**-16),
+    "float32": (2**-14, 2**-30),
+}
+ALIASES = {
+    "output": "attn_out",
+    "out": "attn_out",
+    "attention": "attn_out",
+    "lse": "softmax_lse",
+}
+
+
+def load(path):
+    return torch.load(path, map_location="cpu", weights_only=True)
+
+
+def select(value, key):
+    if key is None:
+        return value
+    if isinstance(value, dict) and key in value:
+        return value[key]
+    for part in key.split("."):
+        value = value[int(part)] if isinstance(value, (list, tuple)) else value[part]
+    return value
+
+
+def outputs(value, key=None, single_name="attn_out"):
+    value = select(value, key)
+    if key is None and isinstance(value, dict):
+        for wrapper in ("outputs", "result", "output"):
+            if wrapper in value:
+                if wrapper == "output" and any(
+                    k in value for k in ("softmax_lse", "lse")
+                ):
+                    continue
+                value = value[wrapper]
+                break
+    if torch.is_tensor(value):
+        return {single_name: value}
+    if isinstance(value, (tuple, list)) and 1 <= len(value) <= 2:
+        return dict(zip(("attn_out", "softmax_lse"), value))
+    if isinstance(value, dict):
+        result = {
+            ALIASES.get(k, k): v
+            for k, v in value.items()
+            if torch.is_tensor(v) or v is None
+        }
+        known = {k: v for k, v in result.items() if k in ("attn_out", "softmax_lse")}
+        if known:
+            return known
+        if result and not any(k in result for k in ("q", "k", "v")):
+            return result
+    raise ValueError(
+        "Cannot locate outputs. Use --inspect FILE and --npu-key/--gpu-key to select the output field."
+    )
+
+
+def cpu_golden(value, attrs=None):
+    # Import only CPU arithmetic, without loading spec.py or framework adapters.
+    directory = Path(__file__).resolve().parent / "impl"
+    name = "_flash_attn_offline_impl"
+    if name not in sys.modules:
+        spec = importlib.util.spec_from_file_location(
+            name, directory / "__init__.py", submodule_search_locations=[str(directory)]
+        )
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+    from _flash_attn_offline_impl.golden import cpu_flash_attn, _run_reference
+    from _flash_attn_offline_impl.fp32_reference import FP32Reference
+
+    attributes = {}
+    if isinstance(value, dict):
+        attributes.update(value.get("attributes", value.get("attrs", {})))
+        value = value.get("inputs", value.get("input_kwargs", value))
+    names = [
+        name
+        for name in inspect.signature(cpu_flash_attn).parameters
+        if name not in ("reference_mode", "_unused")
+    ]
+    if isinstance(value, (tuple, list)):
+        if len(value) > len(names):
+            raise ValueError("Too many positional inputs")
+        value = dict(zip(names, value))
+    if not isinstance(value, dict) or not all(
+        name in value for name in ("q", "k", "v")
+    ):
+        raise ValueError(
+            "Input PT must contain q/k/v by name, or a sequence in FlashAttn argument order"
+        )
+    attributes.update(value.get("attributes", value.get("attrs", {})))
+    attributes.update(attrs or {})
+    arguments = {}
+    for name, param in inspect.signature(cpu_flash_attn).parameters.items():
+        if name in ("reference_mode", "_unused"):
+            continue
+        if name in value:
+            arguments[name] = value[name]
+        elif param.default is not inspect.Parameter.empty:
+            arguments[name] = param.default
+    arguments.update({k: v for k, v in attributes.items() if k in names})
+    if arguments["block_table"] is not None or any(
+        str(arguments[k]).startswith("PA_") for k in ("layout_q", "layout_kv")
+    ):
+        raise ValueError("This offline tool currently supports non-paged inputs only")
+    for name in ("q", "k", "v"):
+        if not torch.is_tensor(arguments[name]):
+            raise ValueError(f"{name} must be a Tensor")
+        arguments[name] = arguments[name].detach().cpu()
+    with torch.no_grad():
+        attention, lse = _run_reference(FP32Reference, arguments)
+    settings = {name: arguments[name] for name in names[11:]}
+    return {"attn_out": attention, "softmax_lse": lse}, settings
+
+
+def array(tensor):
+    tensor = tensor.detach().cpu()
+    return (tensor.float() if tensor.dtype == torch.bfloat16 else tensor).numpy()
+
+
+def ratio(num, den, floor):
+    if math.isnan(num) or math.isnan(den):
+        return float("inf"), "nan"
+    if math.isinf(num) and math.isinf(den):
+        return 1.0, "both_inf"
+    if math.isinf(num):
+        return float("inf"), "npu_inf"
+    if num == 0 and den == 0:
+        return 1.0, "both_zero"
+    return num / max(den, floor), "denominator_floor" if den < floor else "division"
+
+
+def compare(npu, gpu, golden, level="L2", dtype=None):
+    """Match TTK ea32d023 CrossCheckComparison, exposing raw statistics too."""
+    if not all(torch.is_tensor(t) for t in (npu, gpu, golden)):
+        raise ValueError("Each compared output must be a Tensor")
+    if npu.shape != gpu.shape or npu.shape != golden.shape:
+        raise ValueError(
+            f"Shape mismatch: NPU={tuple(npu.shape)}, GPU={tuple(gpu.shape)}, golden={tuple(golden.shape)}"
+        )
+    dtype = dtype or str(npu.dtype).removeprefix("torch.")
+    if dtype not in SMALL:
+        raise ValueError(
+            f"Unsupported output dtype {dtype}; use --dtype if saved outputs lost their original dtype"
+        )
+    tau, atol = SMALL[dtype]
+    limits = dict(zip(("mare", "mere", "rmse"), LEVELS[level]))
+    a, b, c = (array(t).reshape(-1) for t in (npu, gpu, golden))
+    arithmetic_dtype = np.result_type(np.float32, a.dtype, b.dtype, c.dtype)
+    a, b, c = (x.astype(arithmetic_dtype, copy=False) for x in (a, b, c))
+    special = ~np.isfinite(a) | ~np.isfinite(b) | ~np.isfinite(c)
+
+    def equal(x, y):
+        return (
+            (np.isnan(x) & np.isnan(y))
+            | (np.isposinf(x) & np.isposinf(y))
+            | (np.isneginf(x) & np.isneginf(y))
+            | (np.isfinite(x) & np.isfinite(y) & (x == y))
+        )
+
+    # Fold golden only for finite-equality at special positions, as TTK does.
+    folded = array(golden.detach().cpu().to(getattr(torch, dtype))).reshape(-1)
+    match_golden = (
+        (np.isnan(a) & np.isnan(c))
+        | (np.isposinf(a) & np.isposinf(c))
+        | (np.isneginf(a) & np.isneginf(c))
+        | (np.isfinite(a) & np.isfinite(c) & (a == folded))
+    )
+    special_bad = int(np.count_nonzero(special & ~(equal(a, b) | match_golden)))
+    normal = ~special & (np.abs(c) >= tau)
+    small = ~special & (np.abs(c) < tau)
+    raw = {"npu": {}, "gpu": {}}
+    ratios, denominators, cases = {}, {}, {}
+    normal_skipped = False
+    with np.errstate(over="ignore", invalid="ignore", divide="ignore"):
+        if normal.any():
+            reference = c[normal]
+            for name, candidate in (("npu", a[normal]), ("gpu", b[normal])):
+                difference = candidate - reference
+                relative = np.abs(difference) / (np.abs(reference) + 1e-7)
+                raw[name] = {
+                    "mare": float(relative.max()),
+                    "mere": float(relative.sum(dtype=np.float64) / relative.size),
+                    "rmse": math.sqrt(
+                        float(np.square(difference.astype(np.float64)).sum())
+                        / difference.size
+                    ),
+                }
+                if name == "gpu":
+                    normal_skipped = bool(np.all(~np.isfinite(relative)))
+            if not normal_skipped:
+                for name in limits:
+                    ratios[name], cases[name] = ratio(
+                        raw["npu"][name], raw["gpu"][name], tau
+                    )
+                    denominators[name] = max(raw["gpu"][name], tau)
+        bad_npu = int(np.count_nonzero(np.abs(a[small] - c[small]) > atol))
+        bad_gpu = int(np.count_nonzero(np.abs(b[small] - c[small]) > atol))
+    small_ratio = bad_npu / max(bad_gpu, 1)
+    passed = (
+        special_bad == 0
+        and small_ratio <= 2
+        and all(ratios[name] <= limits[name] for name in ratios)
+    )
+    return {
+        "pass": bool(passed),
+        "level": level,
+        "dtype": dtype,
+        "shape": list(npu.shape),
+        "input_dtypes": {
+            "npu": str(npu.dtype),
+            "gpu": str(gpu.dtype),
+            "golden": str(golden.dtype),
+        },
+        "normal_count": int(normal.sum()),
+        "small_count": int(small.sum()),
+        "special_count": int(special.sum()),
+        "special_mismatch_count": special_bad,
+        "raw": raw,
+        "ratios": ratios,
+        "ratio_denominators": denominators,
+        "ratio_cases": cases,
+        "normal_ratios_skipped": normal_skipped,
+        "config": {"limits": limits, "small_value": tau, "small_value_atol": atol},
+        "small_errors": {
+            "npu": bad_npu,
+            "gpu": bad_gpu,
+            "ratio": small_ratio,
+            "limit": 2.0,
+        },
+    }
+
+
+def describe(value, prefix="root", depth=0):
+    if torch.is_tensor(value):
+        print(
+            f"{prefix}: Tensor shape={tuple(value.shape)} dtype={value.dtype} device={value.device}"
+        )
+    elif isinstance(value, dict) and depth < 4:
+        for key, item in value.items():
+            describe(item, f"{prefix}.{key}", depth + 1)
+    elif isinstance(value, (tuple, list)) and depth < 4:
+        for index, item in enumerate(value):
+            describe(item, f"{prefix}.{index}", depth + 1)
+    else:
+        print(f"{prefix}: {type(value).__name__}")
+
+
+def json_safe(value):
+    if torch.is_tensor(value):
+        return json_safe(value.item() if value.numel() == 1 else value.tolist())
+    if isinstance(value, float) and not math.isfinite(value):
+        return str(value)
+    if isinstance(value, dict):
+        return {k: json_safe(v) for k, v in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [json_safe(v) for v in value]
+    return value
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--npu", type=Path, help="Saved NPU outputs; never executes an NPU operator"
+    )
+    parser.add_argument(
+        "--gpu", type=Path, help="Saved GPU outputs; never executes a GPU operator"
+    )
+    source = parser.add_mutually_exclusive_group()
+    source.add_argument(
+        "--inputs",
+        type=Path,
+        help="All FlashAttn inputs in one PT; compute CPU FP32 golden",
+    )
+    source.add_argument(
+        "--golden",
+        type=Path,
+        help="Existing CPU golden PT; compare only, without recomputing golden",
+    )
+    parser.add_argument(
+        "--attrs",
+        type=Path,
+        help="JSON operator attributes, overriding input PT attributes",
+    )
+    for name in ("npu", "gpu", "golden"):
+        parser.add_argument(
+            f"--{name}-key", help="Select a nested output, e.g. outputs or result.0"
+        )
+    parser.add_argument(
+        "--output", choices=("attn_out", "softmax_lse"), help="Compare only this output"
+    )
+    parser.add_argument("--level", choices=LEVELS, default="L2")
+    parser.add_argument(
+        "--dtype",
+        choices=SMALL,
+        help="Override the original output dtype for tolerance lookup",
+    )
+    parser.add_argument(
+        "--report",
+        type=Path,
+        help="Write full-precision raw statistics and ratios as JSON",
+    )
+    parser.add_argument("--save-golden", type=Path, help="Save the computed CPU golden")
+    parser.add_argument(
+        "--inspect",
+        type=Path,
+        help="Print PT keys, shapes and dtypes without computation",
+    )
+    args = parser.parse_args(argv)
+    if args.inspect:
+        describe(load(args.inspect))
+        return 0
+    if not args.npu or not args.gpu or not (args.inputs or args.golden):
+        parser.error(
+            "provide --npu, --gpu and either --inputs or --golden; two outputs alone are not a three-way check"
+        )
+    try:
+        npu = outputs(load(args.npu), args.npu_key, args.output or "attn_out")
+        gpu = outputs(load(args.gpu), args.gpu_key, args.output or "attn_out")
+        settings = None
+        if args.inputs:
+            attrs = json.loads(args.attrs.read_text()) if args.attrs else {}
+            golden, settings = cpu_golden(load(args.inputs), attrs)
+            if args.save_golden:
+                torch.save(golden, args.save_golden)
+        else:
+            golden = outputs(
+                load(args.golden), args.golden_key, args.output or "attn_out"
+            )
+        keys = [args.output] if args.output else list(npu)
+        results = {}
+        for name in keys:
+            if name not in npu or name not in gpu or name not in golden:
+                raise ValueError(
+                    f"Missing {name}; NPU keys={list(npu)}, GPU keys={list(gpu)}, golden keys={list(golden)}"
+                )
+            if name == "softmax_lse" and golden[name] is None:
+                results[name] = {"pass": True, "status": "SUPPRESSED"}
+                continue
+            results[name] = compare(
+                npu[name], gpu[name], golden[name], args.level, args.dtype
+            )
+        if not args.output and set(npu) != set(gpu):
+            raise ValueError(
+                "NPU/GPU output sets differ; select the intended output explicitly"
+            )
+        passed = all(result["pass"] for result in results.values())
+        report = {
+            "pass": passed,
+            "level": args.level,
+            "cpu_golden_settings": settings,
+            "outputs": results,
+        }
+        if settings is not None:
+            print("CPU FP32 golden settings:", json_safe(settings))
+        for name, result in results.items():
+            print(f"\n{name}: {'PASS' if result['pass'] else 'FAIL'}")
+            if "raw" not in result:
+                print(result["status"])
+                continue
+            print(
+                "metric | NPU vs CPU raw | GPU vs CPU raw | ratio | denominator | limit | ratio case"
+            )
+            for metric in ("mare", "mere", "rmse"):
+                print(
+                    " | ".join(
+                        str(v)
+                        for v in (
+                            metric,
+                            result["raw"]["npu"].get(metric),
+                            result["raw"]["gpu"].get(metric),
+                            result["ratios"].get(metric),
+                            result["ratio_denominators"].get(metric),
+                            result["config"]["limits"][metric],
+                            result["ratio_cases"].get(metric),
+                        )
+                    )
+                )
+            print(
+                "counts:",
+                {
+                    k: result[k]
+                    for k in (
+                        "normal_count",
+                        "small_count",
+                        "special_count",
+                        "special_mismatch_count",
+                    )
+                },
+            )
+            print("small errors:", result["small_errors"])
+            if result["normal_ratios_skipped"]:
+                print(
+                    "Normal ratios skipped: GPU relative errors all nonfinite (TTK rule)"
+                )
+        if args.report:
+            args.report.write_text(
+                json.dumps(json_safe(report), indent=2, allow_nan=False) + "\n"
+            )
+        return 0 if passed else 1
+    except (
+        ValueError,
+        KeyError,
+        IndexError,
+        OSError,
+        RuntimeError,
+        TypeError,
+    ) as error:
+        parser.exit(2, f"error: {error}\n")
+
+
+if __name__ == "__main__":
+    sys.exit(main())
