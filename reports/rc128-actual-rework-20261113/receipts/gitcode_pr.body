his Module Will Not Be Displayed.",{"praise":1401},{"tips":1402},"and {num} other reacted with",{"account":1404,"action":1408,"checkIn":1411,"email":1412,"growthPoints":1417,"rule":1418,"subtitle":1422,"tips":1431,"toBeRecei":1453},{"bindPhoneVerification":1405,"enterBoundPhone":1406,"getVerificationCode":1407},"Phone Number Verification","Please Enter the Current Bound Phone Number","Get verification code",{"havSig":1409,"notSign":1410},"Signed","Unsigned","Check In",{"addEmail":1413,"defaultEmail":1414,"enterEmail":1415,"subTitle":1416},"Add","Default","Email","Email is Used to Control the Emails Associated with Your Account, All Available Email Addresses Can Be Used to Identify Your Commits.","Growth Points",{"pleasePhoneCode":1419,"pleaseVerificationCode":1420,"pleEntTheCorUrlAdd":1421},"Please complete SMS verification first by entering the phone number and verification code!","Please enter the correct verification code","Please enter a valid URL",{"accountSecurityCheck":1423,"accountSecurityVerification":1424,"completed":1425,"emailUnavailableEditByPhone":1426,"point":1255,"receiveSuccessfully":1427,"setAsDefault":1428,"toBeCompleted":1429,"toComplete":1430},"Account security check","Account security verification","Completed","Is your email unavailable? You can change it via phone","Claim Successful","Set as default","To be completed","Go to complete",{"cannotDeletedEmail":1432,"checkSuccessPoints":1433,"checkSuccessPoints7":1434,"continueCheckin":1435,"deleteEmail":1436,"enterCorrectPhoneNumber":1437,"enterEmailFormat":1438,"getCodeSuccessfully":1439,"ma":1440,"numDay":1441,"phoneNotRegisteredCheckPhone":1442,"pleaseEnterCode":1443,"pleConTheDel":1444,"resendTheEmailToConfirm":1445,"sentPhoneCodeCheckIt":1446,"sentSuccessfully":1447,"signedIn":1385,"signInEarnPoints":1448,"sureDeleteEmail":1449,"systemHasSentEmail":1450,"unverified":1099,"VerificationCodeToCheckEmail":1451,"youCanCreOrManUp":1452},"Default email cannot be deleted","Check-in successful, points +{num}","Successfully Checked in for 7 Consecutive Days, Points +{num}","Consecutively Signed In for {num} Days","Delete email?","Please enter a valid phone number!","Please enter a valid email format","Verification code obtained successfully","?","Day {num}","This phone number is not registered, please check and enter the correct bound phone number","Please enter the verification code","Please confirm the deletion","Resend email confirmation","Verification code sent to your phone, please check","Sent successfully","Sign in for points","Are you sure you want to delete the email","A verification code has been sent to {email}, please check your email for the next step.","Verification code sent, please check your email","You can create or manage up to {num} organizations, unable to create new ones.","Collect",{"guideEuler":1455,"guideMindspore":1483,"guideTips":1486,"harmonyTransfer":1488,"useGuide":1527},{"agreementTitle":1456,"imageAlt01":1457,"pageTitle":1458,"step01":1459,"step02":1460,"step04":1425,"stepInfo_01":1461,"stepInfo_02":1462,"stepInfo_03":1463,"stepInfo_04":1464,"stepInfo_05":1465,"stepInfo_06":1466,"stepInfo_07":1467,"stepInfo_08":1468,"stepInfo_09":1469,"stepInfo_10":1280,"stepInfo_11":1470,"stepInfo_12":1471,"stepInfo_13":1472,"stepInfo_14":1473,"stepInfo_15":1474,"stepInfo_16":1475,"stepInfo_17":1476,"stepInfo_18":1477,"stepInfo_19":1478,"stepInfo_20":1479,"stepInfo_21":1480,"title01":1481,"title02":1482},"《OpenEuler Project Personal Data Sharing Authorization Agreement》","Operation Guide","openEuler Developer","Login\u002FBind","Add email","Hello developer, welcome to the {siteName} platform!","Click the 'Join now' button to start the login\u002Fbind process","The current account is not yet bound to Gitee. Please log out and authorize login through Gitee","The current account is not a Gitee migration account. Please log in with the Gitee account that needs to be migrated, or contact customer service","You can use this page or","personal settings page","to configure personal email. After completing your personal email, you can log in through it Commit、 Sign CLA and other operations.","This email is generated by the system by default and will be automatically removed after you bind it to a commonly used email","Welcome to the {siteName} platform. To ensure that your authorized data can be migrated from Gitee, please complete the sign of","CLA agreement has an authorization exception, please go to","the CLA signing page","or","Go sign","View exceptions","Your contribution data has been migrated, welcome to join the {siteName} platform!","Let's join hands and build a more prosperous, developed, and win-win open source new ecosystem!","View Agreement","Enter community","Migration Announcement","Please access this page on your computer and contact customer service","Welcome to the {siteName} platform! This guide will help you quickly familiarize yourself with the operation and settings of {siteName}, supporting you to efficiently carry out development collaboration.","{siteName} and Gitee are two independent platforms. After you authorize data migration, we will try our best to retain your previous contribution data (Issue, PR, and comment content).",{"agreementTitle":1484,"pageTitle":1485},"《MindSpore Project Personal Data Sharing Authorization Agreement》","MindSpore Developer",{"dismiss":1487},"Don't show again",{"joinNow":1489,"next":1098,"previous":1110,"tip02":1490,"tip03":1491,"tip03ForAscend":1492,"tip04":1493,"tip05":1494,"tip06":1495,"tip07":1496,"tip08":1497,"tip09":1498,"tip10":1499,"tip11":1500,"tip12":1501,"tip13":1502,"tip14":1503,"tip15":1504,"tip16":1505,"tip17":1506,"tip18":1507,"tip19":1508,"tip20":1509,"tip21":1510,"tip22":1511,"tip23":1512,"tip24":1513,"tip25":1514,"tip27":1515,"tip28":1516,"tip29":1517,"tip30":1518,"tip31":1519,"tip32":1520,"tip34":1521,"tip35":1522,"tip36":1523,"tip37":1524,"tip38":1525,"title":1526},"Join now","Step by step guide","GitCode and gitee are two independent platforms. After you authorize data migration, we will retain your previous contribution data (issue, pull requests and comments) as much as possible.","GitCode and Gitee are two independent platforms. To synchronize your previous contribution data (issue, pull requests and comments), please follow the following process to authorize data migration using Gitee.","Account settings","Login and initialization: You can log in to GitCode via Gitee Oauth2 directly without re-registering. After logging in for the first time, it is recommended to set an exclusive GitCode password immediately to ensure the security of the account, and bind the frequently used email to receive important notifications.","Password setting","Once logged in, click your avatar in the upper right corner > personal settings > account settings","Email settings","Click your avatar in the upper right corner > personal settings > email. After verified your email, you can use it to log in, git commit, sign CLA and other operations.","Dashboard","With GitCode dashboard, you can easily check the pending Issues and PR. GitCode uses different states (such as \"pending review\", \"merged\" and \"in progress\") to clearly distinguish the progress of tasks to help you plan your work reasonably.","Quickly find specified Issues through filters or keywords","or PR",", ensuring that important tasks are clear at a glance.","Collaboration","Repo tool download","\"We offer customized Repo tools aligned with Gitee's functionality, supporting batch download\u002Fupdate\u002Fmerge of multiple repositories to ensure seamless development workflows for {developerName}.","Usage Guide:","\"Fork + PR\r\r\nFork Management:Click \"\"Fork\"\" on the project details page to clone the repository to your personal space for independent development and version control.","PR Operations Guide:Submit changes via \"\"Create PR\"\" after modifications. Associate related Issues in the PR interface to close tasks. GitCode also provides Cherry-pick and cross-branch sync to integrate critical fixes\u002Ffeatures into multiple branches.\"","\"issue\r\r\nIssue Creation:Click \"\"New Issue\"\" on the project page to report bugs\u002Fsuggestions. Tag with priority levels and labels for accelerated team triage.","PR Linking:Add relevant PR links in Issue discussions during development, creating traceable code-task connections. GitCode automatically syncs status between linked PRs and Issues.\"","Join Orgs & Projects","Administrators can invite others to join the team through the \"Member Management\" page, and the invitee can join after accepting the invitation.","Direct invitation","Invitation link","Administrators and maintainers of organizations\u002Fprojects can invite GitCode users to join the organization or project through invitation links.","Join via direct invitation acceptance or invitation links. Team members gain instant collaboration access upon joining.","When invited to organizations\u002Fprojects, GitCode users receive alerts via notification center and email. Click notification links to review invitation details and accept\u002Fdecline.","Clicking invitation links generates join requests for organizations\u002Fprojects. Admins\u002Fmaintainers review and approve to grant membership.","Orgs & Project Management","Organization admins configure organization\u002Fproject-level Webhooks in Organization Settings and Project Settings.","issue template, label","Create unified issue templates and labels to maintain consistent development practices across teams.","Project permission setting","The access and operation permissions of different members can be set according to the needs of the project to ensure the security of the project.","Welcome to the GitCode platform! This guide will help you quickly familiarize yourself with the operation and settings of GitCode and support you to carry out development collaboration efficiently.",{"ascend":1528,"boostkit":1531,"cann":1534,"developerName":1537,"migrate":1542,"openGauss":1545},{"cta":1529,"title":1530},"Go to the Ascend community","Ascend developer guide",{"cta":1532,"title":1533},"Go to the BoostKit community","BoostKit developer guide",{"cta":1535,"title":1536},"Go to the CANN community","CANN developer guide",{"ascend":1538,"boostkit":1539,"cann":1540,"opengauss":1541},"Ascend developers","BoostKit developers","CANN developers","OpenGauss developers",{"inviteContent":1543,"inviteTitle":1544},"Dear HarmonyOS developer: thank you for supporting the GitCode platform! To build a more efficient open source collaboration environment, we invite you to take part in this anonymous survey. Your feedback directly shapes our roadmap and helps us build a better developer ecosystem.","GitCode developer experience optimization program invitation",{"title":1546},"openGauss developer guide",{"activity":1548,"aihub":1550,"header":1558,"home":1560,"hotConcept":1764,"search":1780,"topic":1782},{"to":1549},"To",{"comprehensiveRanking":1414,"header":1551,"not_started":1553,"paused":1554,"running":1555,"search_space":1556,"suspended":1557},{"aihub":1552},"AI Hub","Not Started","Paused","Running","Search Space","Sleeping",{"applicationMarket":1559},"Application Market",{"aiModel":1561,"alreadyFollowed":1563,"apps":1564,"atomgitEnterprise":1566,"backToChannels":1612,"channel":1613,"companyInformation":1641,"companyInformationAtomgit":1642,"competition":1643,"copyright_atomgit":1644,"digest":1648,"discoverMore":1649,"domesticZone":1650,"dynamics":1652,"dynamicsRate":1654,"dynamicsShare":1664,"feedbackCenter":1670,"filter":1671,"focusOn":1179,"gstar":1691,"hotFlag":1693,"hotSelection":1698,"HWCloud":1708,"industryNews":1709,"informationCenter":1723,"modelFeatured":1724,"modelTree":1727,"newTag":1732,"noDescroption":1734,"onWeekdays":1735,"org":1736,"organizations":1738,"recommend":1740,"recordInformation":1743,"recordInformationAtomGit":1646,"repoCard":1744,"showMore":1035,"sideNav":1746,"slogon":1750,"starNum":1687,"subChannel":1751,"techni