>>>>></a></td>\n                        <td><a href=></a></td>\n                    </tr> \n                    <tr>\n                        <td><strong>UT_Test_ophost</strong></td>\n                        <td>✅ SUCCESS</td>\n                        <td><a href=></a></td>\n                        <td><a href=></a></td>\n                    </tr> \n                    <tr>\n                        <td><strong>UT_Test_opapi</strong></td>\n                        <td>✅ SUCCESS</td>\n                        <td><a href=></a></td>\n                        <td><a href=></a></td>\n                    </tr> \n                    <tr>\n                        <td><strong>UT_Test_kernel</strong></td>\n                        <td>✅ SUCCESS</td>\n                        <td><a href=></a></td>\n                        <td><a href=></a></td>\n                    </tr> \n                    <tr>\n                        <td><strong>UT_Test_opgraph</strong></td>\n                        <td>✅ SUCCESS</td>\n                        <td><a href=></a></td>\n                        <td><a href=></a></td>\n                    </tr> \n                    <tr>\n                        <td><strong>Smoke_A900_npupool</strong></td>\n                        <td>✅ SUCCESS</td>\n                        <td><a href=></a></td>\n                        <td><a href=https://ascend-ci.obs.cn-north-4.myhuaweicloud.com/ops-nn/package/2939/slog.tar.gz>>>>>></a></td>\n                    </tr> </table><p>[2026-03-19 19:02:31] &nbsp;&nbsp;&nbsp;CI执行结束 </p>","created_at":"2026-03-19T18:58:09+08:00","updated_at":"2026-03-19T19:02:32+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":165784575,"discussion_id":"0e306625df3691d93eb43de7377bb898df6cd76d","body":"## 问题/功能描述\n\n本次PR系列主要修复了多个AscendC确定性算子（包括InplaceIndexAdd、ScatterAdd、ScatterNd、ScatterNdAdd）在初始化阶段存在的内存访问时序问题。在多核或异步硬件（如MTE3）并行访问场景下，对全局工作内存（GM）的初始化操作可能与其他核或硬件单元的访问产生数据竞争，导致未定义行为，影响计算的确定性和正确性。\n\n## 修改方案描述\n\n核心修改方案是在各算子的初始化函数中，在对关键全局内存（如`updateSumIdxWsGm_`、`workspaceCoreLogicCoreSumId_`）执行`InitGlobalMemory`操作之前，显式插入对`HardEvent::MTE3_V`硬件事件的等待操作。具体通过调用`GetTPipePtr()->FetchEventID`获取事件ID，并执行`SetFlag`和`WaitFlag`，强制后续内存初始化操作等待前序相关内存操作（如对`updateSumWsGm_`的初始化）完成。此方案相当于在内存访问关键路径上增加了硬件级同步屏障，确保了内存初始化的顺序一致性，消除了潜在的竞态条件。此外，部分算子还优化了初始化代码的执行顺序，进一步保证了工作空间在计算开始前已被正确设置。","created_at":"2026-03-19T19:03:29+08:00","updated_at":"2026-03-19T19:03:29+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":165809978,"discussion_id":"cbc2ee9a59a9723d0f2c1ddbe432f7f97ef102fa","body":"/approve","created_at":"2026-03-19T21:22:30+08:00","updated_at":"2026-03-19T21:22:30+08:00","user":{"id":"6880d13aba419813105ac7ab","login":"tangweiwei2","object_id":"6880d13aba419813105ac7ab","name":"tangweiwei2","html_url":"https://gitcode.com/tangweiwei2"},"comment_type":"pr_comment"},{"id":165815810,"discussion_id":"6c5ce9d61184ded35acac77302f3f0f1fa85514f","body":"/lgtm\n/approve","created_at":"2026-03-19T22:01:15+08:00","updated_at":"2026-03-19T22:01:15+08:00","user":{"id":"6861e48dadc5e31e4da8818d","login":"chenqi317","object_id":"6861e48dadc5e31e4da8818d","name":"chenqi317","avatar_url":"","html_url":"https://gitcode.com/chenqi317"},"comment_type":"pr_comment"},{"id":165815852,"discussion_id":"3648f9d5e624dbc878b463a01b8abf364c7941a8","body":"### Review Guide\n\n This pull-request **passes review**.\n Committers who wrote a comment of `/approve` are: [*tangweiwei2*](https://gitcod