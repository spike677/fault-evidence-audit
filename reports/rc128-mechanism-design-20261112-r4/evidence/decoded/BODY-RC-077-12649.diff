+__aicore__ inline void FFTSCrossCoreSync(uint64_t mode, uint64_t flag_id)
+{
+    uint64_t config = 1 | (mode << 4) | (flag_id << 8);
+    ffts_cross_core_sync(pipe, config);
+}
