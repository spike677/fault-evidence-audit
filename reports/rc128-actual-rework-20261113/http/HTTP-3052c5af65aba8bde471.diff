+IMPL = Path(__file__).resolve().parents[3] / "attention/flash_attn/tests/assets/impl"
+SPEC = importlib.util.spec_from_file_location(
+    "_fa_l2_test_impl", IMPL / "__init__.py", submodule_search_locations=[str(IMPL)]
+)
+PACKAGE = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = PACKAGE
+SPEC.loader.exec_module(PACKAGE)
+golden = importlib.import_module(f"{SPEC.name}.golden")
+reference = importlib.import_module(f"{SPEC.name}.reference")
+cross_check = importlib.import_module(f"{SPEC.name}.cross_check")
