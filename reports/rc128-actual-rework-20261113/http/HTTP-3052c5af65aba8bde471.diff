+def test_csv_and_reference_modes(monkeypatch):
+    # Explicit NPU selection retains the non-cross-check reference choices.
+    monkeypatch.setenv("FLASH_ATTN_CROSS_CHECK_BACKEND", "npu")
+    assert spec.FlashAttnSpec.compare is None
+    assert spec.FlashAttnSpec.third_party["torch"] is cross.FA3ThirdParty
+    rows = list(csv.DictReader((ASSETS / "testcase/flash_attn_fa3.csv").open()))
+    assert len(rows) == 8
