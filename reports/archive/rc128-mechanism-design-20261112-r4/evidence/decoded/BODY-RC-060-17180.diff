+        self.key_cache, self.value_cache, _, _ = mxfp_paged_cache_views(
+            raw,
+            self.NUM_BLOCKS,
+            self.NUM_KV_HEADS,
+            self.HEAD_DIM,
+            self.HEAD_DIM,
+            self.BLOCK_SIZE,
+        )
