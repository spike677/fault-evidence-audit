+                cu_seqlens_kv=None,
+                seqused_q=None,
+                seqused_kv=seqused_kv,
+                max_seqlen_q=max_seqlen_q,
+                max_seqlen_kv=-1,
+                mask_mode=mask_mode,
+                win_left=-1,
+                win_right=-1,
+                layout_q=QFA_LAYOUT_TND,
+                layout_q_descale=layout_q_descale,
+                layout_kv=QFA_LAYOUT_PA_NZ,
+                layout_out=QFA_LAYOUT_TND,
