cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":166745909,"discussion_id":"9c3fea62f779d2b0aab792a1722e8d57a6ebd6a5","body":"compile","created_at":"2026-03-28T17:09:54+08:00","updated_at":"2026-03-28T17:09:54+08:00","user":{"id":"68be451c2c2c2604ed90076c","login":"wang-yingzhen-77","object_id":"68be451c2c2c2604ed90076c","name":"wang-yingzhen-77","html_url":"https://gitcode.com/wang-yingzhen-77"},"comment_type":"pr_comment"},{"id":166745995,"discussion_id":"d65e7400d84fcbc34dc74ce8f59a2c63541f01df","body":"## 问题/功能描述\n\n本次PR旨在优化Flash Attention向量化计算内核中全量化（FullQuant）路径在特定配置下的性能或精度。具体而言，针对MLA全量化、非BNSD布局且组大小（gSize）大于等于32的场景，通过引入新的条件分支，优化了计算逻辑。\n\n## 修改方案描述\n\n修改集中于`ProcessVec1Nd`函数，通过新增一个运行时布尔变量`isMlaFullQuantGsize32`来动态判断是否满足上述优化条件。根据该条件，在调用底层向量化处理函数`ProcessVec1Vf`时，动态选择传入`true`或`false`作为`useMlaSgdFlag`模板参数。此改动确保了在`s2RealSize`为128、小于等于64以及在64到128之间等多种情况下，优化逻辑仅在正确的配置下被启用，从而提升特定场景的计算效率。","created_at":"2026-03-28T17:10:24+08:00","updated_at":"2026-03-28T17:10:24+08:00","user":{"id":"673c1552584fe8295cfd4a13","login":"cann-robot","object_id":"673c1552584fe8295cfd4a13","name":"CANN-robot","avatar_url":"https://cdn-img.gitcode.com/bf/ad/b7f29486a040d7b2f52bf6c78414692d7d585eb1ec628cea3eb01c9d63f68618.png?time=1755691472703","html_url":"https://gitcode.com/cann-robot"},"comment_type":"pr_comment"},{"id":166746095,"discussion_id":"086f5f6cda39d15b2efd4a28527a2e710dd97c67","body":"流水线任务触发成功\n任务链接 [<b><a href='https://www.openlibing.com/apps/pipelineDetail?pipelineId=0d4f52bd3a494432a028df25bc3297f8&pipelineRunId=84c2e556c7534e6ca358e5410beb5f71&projectName=CANN'>84c2e556c7534e6ca358e5410beb5f71</a></b>][<b><a href='https://gitcode.com/cann/infrastructure/blob/main/docs/ci/ci_guide.md'>流水线指导</a></b>]\n<table style=\"border-col