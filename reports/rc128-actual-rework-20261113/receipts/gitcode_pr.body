er_id":9,"is_member":18,"enterprise_name":9},{"id":47,"name":48,"username":48,"iam_id":49,"state":213,"avatar_url":50,"avatar_path":9,"email":52,"name_cn":52,"web_url":53,"nick_name":54,"tenant_name":9,"is_codeowner":9,"user_id":9,"is_member":66,"enterprise_name":9},"143d76cbdbad4f21ac9d20fda9cc9697",{},{"id":330,"individual_note":66,"notes":331,"project_id":10,"noteable_type":254,"commit_id":9,"project_full_path":14,"deleted_file":9,"new_file":9,"resolved":18,"archived":66,"review_categories":9,"review_categories_cn":52,"review_categories_en":52,"review_modules":9,"severity":285,"severity_cn":286,"severity_en":287,"assignee":340,"proposer":341,"issue":9,"merge_request_version_params":9,"diff_file":9,"diff":9,"added_lines":9,"removed_lines":9,"old_blob_id":9,"new_blob_id":9,"body":293,"action":9,"author":9,"created_at":336,"updated_at":9,"discussion_id":9,"project":9,"merge_request_id":9,"data_id":342,"audit_result":343,"risk_level":9,"role":9,"a_mode":9,"b_mode":9,"riskLevel":9},"0a20052aa580a52556e9e07884d43b9dfdeb1bdc",[332],{"id":333,"type":9,"body":334,"attachment":9,"author":335,"created_at":336,"updated_at":336,"system":18,"noteable_id":205,"noteable_type":254,"commit_id":9,"resolvable":18,"is_reply":18,"resolved_by":9,"noteable_iid":9,"discussion_id":330,"project":14,"diff_file":9,"diff":9,"archived":66,"review_categories":9,"review_categories_cn":52,"review_categories_en":52,"review_modules":9,"severity":285,"severity_cn":286,"severity_en":287,"file_path":9,"line":9,"assignee":337,"proposer":338,"position":9,"original_position":9,"resolved":9,"is_outdated":9,"issue":9,"new_line":9,"content":9,"change_content":9,"is_expired_suggestion":9,"__bodyHtml":339,"key":333},167477503,"## 问题\u002F功能描述\n\n本次PR修改旨在解决因硬件控制寄存器状态未初始化，可能导致向量计算单元工作异常或性能下降的问题。通过在`ElementwiseSchWithScalar`类的构造函数中增加对特定硬件控制位的初始化操作，确保后续的向量化元素级计算能在正确的硬件环境下执行。\n\n## 修改方案描述\n\n修改了`ElementwiseSchWithScalar`模板类的构造函数，在初始化成员变量前新增了三行代码。具体操作为：读取当前控制寄存器值，保留特定比特位（0x1000000000000），然后与新的控制位（0x1000000000000008）进行按位或操作，最后将结果写回寄存器。此修改通过原子操作（`get_ctrl`\u002F`set_ctrl`）安全地配置了硬件功能，为后续计算提供了必要的硬件支持。",{"id":47,"name":48,"username":48,"iam_id":49,"state":213,"avatar_url":50,"avatar_path":9,"email":52,"name_cn":52,"web_url":53,"nick_name":54,"tenant_name":9,"is_codeowner":9,"user_id":9,"is_member":66,"enterprise_name":9},"2026-04-07T09:36:22.925+08:00",{"id":216,"name":217,"username":217,"iam_id":218,"state":213,"avatar_url":9,"avatar_path":9,"email":52,"name_cn":52,"web_url":219,"nick_name":217,"tenant_name":9,"is_codeowner":9,"user_id":9,"is_member":18,"enterprise_name":9},{"id":47,"name":48,"username":48,"iam_id":49,"state":213,"avatar_url":50,"avatar_path":9,"email":52,"name_cn":52,"web_url":53,"nick_name":54,"tenant_name":9,"is_codeowner":9,"user_id":9,"is_member":66,"enterprise_name":9},"\u003Ch2 id=\"问题功能描述\" tabindex=\"-1\">\u003Ca href=\"#问题功能描述\" name=\"问题功能描述\" rel=\"nofollow\" class=\"header-anchor\">\u003Cspan class=\"gitcode-anchor\" style=\"display:inline-block;\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\u003Cpath d=\"M11.182 1.98956C10.9867 1.7943 10.6702 1.7943 10.4749 1.98956L6.9393 5.52512L6.2322 4.81801L9.7678 1.28245C10.3536 0.696664 11.3033 0.696667 11.8891 1.28245L14.7175 4.11088C15.3033 4.69667 15.3033 5.64642 14.7175 6.2322L11.1819 9.76776L10.4748 9.06065L14.0104 5.52509C14.2057 5.32983 14.2057 5.01325 14.0104 4.81798L11.182 1.98956ZM1.98962 11.182C1.79436 10.9867 1.79436 10.6701 1.98962 10.4748L5.52516 6.93931L4.81805 6.23221L1.28252 9.76774C0.69673 10.3535 0.696729 11.3033 1.28252 11.8891L4.11094 14.7175C4.69673 15.3033 5.64648 15.3033 6.23226 14.7175L9.7678 11.182L9.06069 10.4748L5.52516 14.0104C5.32989 14.2056 5.01331 14.2056 4.81805 14.0104L1.98962 11.182ZM9.76775 5.52513L5.52511 9.76777L6.23221 10.4749L10.4749 6.23224L9.76775 5.52513Z\" fill=\"var(--theme-icon-fill-weak)\">\u003C\u002Fpath>\u003C\u002Fsvg>\u003C\u002Fspan>\u003C\u002Fa>问题\u002F功能描述\u003C\u002Fh2>\n\u003Cp>本次PR修改旨在解决因硬件控制寄存器状态未初始化，可能导致向量计算单元工作异常或性能下降的问题。通过在\u003Ccode>ElementwiseSchWithScalar\u003C\u002Fcode>类的构造函数中增加对特定硬件控制位的初始化操作，确保后续的向量化元素级计算能在正确的硬件环境下执行。\u003C\u002Fp>\n\u003Ch2 id=\"修改方案描述\" tabindex=\"-1\">\u003Ca href=\"#修改方案描述\" name=\"修改方案描述\" rel=\"nofollow\" class=\"header-anchor\">\u003Cspan class=\"gitcode-anchor\" style=\"display:inline-block;\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\u003Cpath d=\"M11.182 1.98956C10.9867 1.7943 10.6702 1.7943 10.4749 1.98956L6.9393 5.52512L6.2322 4.81801L9.7678 1.28245C10.3536 0.696664 11.3033 0.696667 11.8891 1.28245L14.7175 4.11088C15.3033 4.69667 15.3033 5.64642 14.7175 6.2322L11.1819 9.76776L10.4748 9.06065L14.0104 5.52509C14.2057 5.32983 14.2057 5.01325 14.0104 4.81798L11.182 1.98956ZM1.98962 11.182C1.79436 10.9867 1.79436 10.6701 1.98962 10.4748L5.52516 6.93931L4.81805 6.23221L1.28252 9.76774C0.69673 10.3535 0.696729 11.3033 1.28252 11.8891L4.11094 14.7175C4.69673 15.3033 5.64648 15.3033 6.23226 14.7175L9.7678 11.182L9.06069 10.4748L5.52516 14.0104C5.32989 14.2056 5.01331 14.2056 4.81805 14.0104L1.98962 11.182ZM9.76775 5.52513L5.52511 9.76777L6.23221 10.4749L10.4749 6.23224L9.76775 5.52513Z\" fill=\"var(--theme-icon-fill-weak)\">\u003C\u002Fpath>\u003C\u002Fsvg>\u003C\u002Fspan>\u003C\u002Fa>修改方案描述\u003C\u002Fh2>\n\u003Cp>修改了\u003Ccode>ElementwiseSchWithScalar\u003C\u002Fcode>模板类的构造函数，在初始化成员变量前新增了三行代码。具体操作为：读取当前控制寄存器值，保留特定比特位（0x1000000000000），然后与新的控制位（0x1000000000000008）进行按位或操作，最后将结果写回寄存器。此修改通过原子操作（\u003Ccode>get_ctrl\u003C\u002Fcode>\u002F\u003Ccode>set_ctrl\u003C\u002Fcode>）安全地配置了硬件功能，为后续计算提供了必要的硬件支持。\u003C\u002Fp>\n",{"id":216,"name":217,"username":217,"iam_id":218,"state":213,"avatar_url":9,"avatar_path":9,"email":52,"name_cn":52,"web_url":219,"nick_name":217,"tenant_name":9,"is_codeowner":9,"user_id":9,"is_member":18,"enterprise_name":9},{"id":47,"name":48,"username":48,"iam_id":49,"state":213,"avatar_url":50,"avatar_path":9,"email":52,"name_cn":52,"web_url":53,"nick_name":54,"tenant_name":9,"is_codeowner":9,"user_id":9,"i