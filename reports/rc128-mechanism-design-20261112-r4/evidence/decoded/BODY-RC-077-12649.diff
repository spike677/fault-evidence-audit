+        peerWindow.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(
+            GetWindowAddress(peer) + bankOffset));
+        DataCopy(peerWindow[offset], copy, count);
+        SyncPipe<HardEvent::MTE3_S>();
+    }
